#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="/usr/local/libexec/myos/common.sh"
# shellcheck disable=SC1091
source "${COMMON_SH}"

K3S_BIN="/usr/local/bin/k3s"
SERVER_SERVICE="k3s.service"
AGENT_SERVICE="k3s-agent.service"
SERVER_ENV="/etc/systemd/system/${SERVER_SERVICE}.env"
AGENT_ENV="/etc/systemd/system/${AGENT_SERVICE}.env"
SERVER_OVERRIDE_DIR="/etc/systemd/system/${SERVER_SERVICE}.d"
SERVER_OVERRIDE_FILE="${SERVER_OVERRIDE_DIR}/10-myos-cluster.conf"
AGENT_OVERRIDE_DIR="/etc/systemd/system/${AGENT_SERVICE}.d"
AGENT_OVERRIDE_FILE="${AGENT_OVERRIDE_DIR}/10-myos-cluster.conf"
NODE_TOKEN_FILE="/var/lib/rancher/k3s/server/node-token"
KUBECONFIG_FILE="/etc/rancher/k3s/k3s.yaml"
DEFAULT_API_PORT="6443"

usage() {
  cat <<'EOF'
Usage:
  myos cluster init
  myos cluster join <server> <token> [--role agent|server]
  myos cluster status

Notes:
  - init boots the local node as the first k3s server with embedded etcd.
  - join defaults to an agent node; pass --role server to add another control-plane node.
  - <server> may be a bare host, host:port, or full https:// URL.
EOF
}

require_k3s() {
  [[ -x "${K3S_BIN}" ]] || die "k3s is not installed in this image"
}

service_unit_present() {
  local service="$1"
  [[ -f "/etc/systemd/system/${service}" || -f "/usr/lib/systemd/system/${service}" ]]
}

require_service_units() {
  service_unit_present "${SERVER_SERVICE}" || die "Missing ${SERVER_SERVICE}"
  service_unit_present "${AGENT_SERVICE}" || die "Missing ${AGENT_SERVICE}"
}

restore_context_if_present() {
  if command -v restorecon >/dev/null 2>&1; then
    restorecon -RF "$@" 2>/dev/null || true
  fi
}

write_empty_env_file() {
  local path="$1"
  ensure_dir 0755 root root "$(dirname "${path}")"
  : > "${path}"
  chown root:root "${path}"
  chmod 0600 "${path}"
  restore_context_if_present "${path}"
}

append_env_var() {
  local path="$1"
  local key="$2"
  local value="$3"
  printf '%s=%q\n' "${key}" "${value}" >> "${path}"
}

remove_if_present() {
  local path="$1"
  rm -f "${path}"
}

remove_dir_if_empty() {
  local path="$1"
  rmdir --ignore-fail-on-non-empty "${path}" 2>/dev/null || true
}

clear_role_config() {
  local env_file="$1"
  local override_file="$2"
  local override_dir
  override_dir="$(dirname "${override_file}")"
  remove_if_present "${env_file}"
  remove_if_present "${override_file}"
  remove_dir_if_empty "${override_dir}"
}

service_disable_now() {
  local service="$1"
  systemctl disable --now "${service}" >/dev/null 2>&1 || true
  systemctl reset-failed "${service}" >/dev/null 2>&1 || true
}

service_enable_restart() {
  local service="$1"
  systemctl daemon-reload
  systemctl enable "${service}" >/dev/null
  systemctl restart "${service}"
}

wait_for_service_active() {
  local service="$1"
  local timeout_seconds="${2:-60}"
  local _
  for _ in $(seq 1 "${timeout_seconds}"); do
    if systemctl is-active --quiet "${service}"; then
      return 0
    fi
    sleep 1
  done

  systemctl --no-pager --full status "${service}" || true
  die "Timed out waiting for ${service} to become active"
}

wait_for_file() {
  local path="$1"
  local timeout_seconds="${2:-60}"
  local _
  for _ in $(seq 1 "${timeout_seconds}"); do
    [[ -s "${path}" ]] && return 0
    sleep 1
  done
  die "Timed out waiting for ${path}"
}

tailscale_status_json() {
  command -v tailscale >/dev/null 2>&1 || return 1
  tailscale status --json 2>/dev/null
}

tailscale_preferred_host() {
  local status_json
  status_json="$(tailscale_status_json)" || return 1

  STATUS_JSON="${status_json}" python3 - <<'PY'
import ipaddress
import json
import os

raw = os.environ.get("STATUS_JSON", "").strip()
if not raw:
    raise SystemExit(1)

data = json.loads(raw)
self_info = data.get("Self") or {}
ips = []
for value in self_info.get("TailscaleIPs") or []:
    if isinstance(value, str) and value.strip():
        ips.append(value.strip())

if ips:
    def sort_key(value: str):
        ip = ipaddress.ip_address(value)
        return (0 if ip.version == 4 else 1, value)

    print(sorted(ips, key=sort_key)[0])
    raise SystemExit(0)

dns_name = self_info.get("DNSName")
if isinstance(dns_name, str) and dns_name.strip():
    print(dns_name.rstrip('.'))
    raise SystemExit(0)

raise SystemExit(1)
PY
}

fallback_cluster_host() {
  if hostname -f >/dev/null 2>&1; then
    hostname -f
  else
    hostname
  fi
}

preferred_cluster_host() {
  tailscale_preferred_host || fallback_cluster_host
}

normalize_server_url() {
  local server="$1"

  if [[ "${server}" =~ ^https:// ]]; then
    printf '%s\n' "${server}"
    return 0
  fi

  if [[ "${server}" =~ ^http:// ]]; then
    die "k3s join endpoints must use https://"
  fi

  if [[ "${server}" =~ ^\[[^]]+\]:[0-9]+$ ]]; then
    printf 'https://%s\n' "${server}"
    return 0
  fi

  if [[ "${server}" =~ ^\[[^]]+\]$ ]]; then
    printf 'https://%s:%s\n' "${server}" "${DEFAULT_API_PORT}"
    return 0
  fi

  if [[ "${server}" == *:*:* ]]; then
    printf 'https://[%s]:%s\n' "${server}" "${DEFAULT_API_PORT}"
    return 0
  fi

  if [[ "${server}" == *:* ]]; then
    printf 'https://%s\n' "${server}"
    return 0
  fi

  printf 'https://%s:%s\n' "${server}" "${DEFAULT_API_PORT}"
}

server_url_from_host() {
  local host="$1"

  if [[ "${host}" == *:* ]]; then
    printf 'https://[%s]:%s\n' "${host}" "${DEFAULT_API_PORT}"
  else
    printf 'https://%s:%s\n' "${host}" "${DEFAULT_API_PORT}"
  fi
}

write_server_override() {
  local exec_args="$1"

  ensure_dir 0755 root root "${SERVER_OVERRIDE_DIR}"
  cat > "${SERVER_OVERRIDE_FILE}" <<EOF
[Service]
ExecStart=
ExecStart=${K3S_BIN} server ${exec_args}
EOF
  chown root:root "${SERVER_OVERRIDE_FILE}"
  chmod 0644 "${SERVER_OVERRIDE_FILE}"
  restore_context_if_present "${SERVER_OVERRIDE_DIR}"
}

server_join_endpoint() {
  local configured_server

  if [[ -f "${AGENT_ENV}" ]]; then
    sed -n 's/^K3S_URL=//p' "${AGENT_ENV}" | head -n1
    return 0
  fi

  if [[ -f "${SERVER_OVERRIDE_FILE}" ]]; then
    configured_server="$(sed -n 's/^ExecStart=.* --server=\([^ ]*\).*$/\1/p' "${SERVER_OVERRIDE_FILE}" | head -n1)"
    if [[ -n "${configured_server}" ]]; then
      printf '%s\n' "${configured_server}"
      return 0
    fi
  fi

  local cluster_host
  cluster_host="$(preferred_cluster_host)"
  server_url_from_host "${cluster_host}"
}

show_service_summary() {
  local service="$1"
  local label="$2"
  local enabled_state active_state

  enabled_state="$(systemctl is-enabled "${service}" 2>/dev/null || true)"
  active_state="$(systemctl is-active "${service}" 2>/dev/null || true)"
  printf '%s: enabled=%s active=%s\n' "${label}" "${enabled_state:-unknown}" "${active_state:-unknown}"
}

cmd_init() {
  local cluster_host server_url token

  require_root
  require_k3s
  require_service_units

  cluster_host="$(preferred_cluster_host)"
  server_url="$(server_url_from_host "${cluster_host}")"

  service_disable_now "${AGENT_SERVICE}"
  clear_role_config "${AGENT_ENV}" "${AGENT_OVERRIDE_FILE}"

  write_empty_env_file "${SERVER_ENV}"
  write_server_override "--cluster-init --tls-san=${cluster_host}"

  service_enable_restart "${SERVER_SERVICE}"
  wait_for_service_active "${SERVER_SERVICE}" 90
  wait_for_file "${NODE_TOKEN_FILE}" 90

  token="$(tr -d '\n' < "${NODE_TOKEN_FILE}")"

  cat <<EOF
Initialized k3s server with embedded etcd.

Join endpoint: ${server_url}
Join token: ${token}

Add an agent:
  myos cluster join ${cluster_host} ${token}

Add another server:
  myos cluster join ${cluster_host} ${token} --role server
EOF
}

cmd_join() {
  local server="$1"
  local token="$2"
  shift 2

  local role="agent"
  local server_url

  while (($#)); do
    case "$1" in
      --role)
        [[ $# -ge 2 ]] || die "Missing value for --role"
        role="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown join argument: $1"
        ;;
    esac
  done

  case "${role}" in
    agent|server)
      ;;
    *)
      die "Unsupported role '${role}'; expected 'agent' or 'server'"
      ;;
  esac

  require_root
  require_k3s
  require_service_units

  [[ -n "${token}" ]] || die "Join token must not be empty"
  server_url="$(normalize_server_url "${server}")"

  if [[ "${role}" == "agent" ]]; then
    service_disable_now "${SERVER_SERVICE}"
    clear_role_config "${SERVER_ENV}" "${SERVER_OVERRIDE_FILE}"
    clear_role_config "${AGENT_ENV}" "${AGENT_OVERRIDE_FILE}"

    write_empty_env_file "${AGENT_ENV}"
    append_env_var "${AGENT_ENV}" "K3S_URL" "${server_url}"
    append_env_var "${AGENT_ENV}" "K3S_TOKEN" "${token}"

    service_enable_restart "${AGENT_SERVICE}"
    wait_for_service_active "${AGENT_SERVICE}" 90

    printf 'Joined cluster as agent via %s\n' "${server_url}"
    return 0
  fi

  service_disable_now "${AGENT_SERVICE}"
  clear_role_config "${AGENT_ENV}" "${AGENT_OVERRIDE_FILE}"

  write_empty_env_file "${SERVER_ENV}"
  append_env_var "${SERVER_ENV}" "K3S_TOKEN" "${token}"
  # TODO: If operators later use every control-plane node as a direct join
  # endpoint, evaluate whether each joined server should also inject its own
  # Tailscale address via --tls-san in addition to the bootstrap endpoint.
  write_server_override "--server=${server_url}"

  service_enable_restart "${SERVER_SERVICE}"
  wait_for_service_active "${SERVER_SERVICE}" 90

  printf 'Joined cluster as server via %s\n' "${server_url}"
}

cmd_status() {
  require_root
  require_k3s
  require_service_units

  show_service_summary "${SERVER_SERVICE}" "Server unit"
  show_service_summary "${AGENT_SERVICE}" "Agent unit"
  printf 'Preferred join endpoint: %s\n' "$(server_join_endpoint)"

  if [[ -f "${KUBECONFIG_FILE}" ]]; then
    printf '\nCluster nodes:\n'
    if ! "${K3S_BIN}" kubectl get nodes -o wide; then
      printf 'k3s API is not ready yet or this node does not currently have usable server kubeconfig.\n'
    fi
  fi
}

main() {
  [[ $# -gt 0 ]] || {
    usage
    exit 1
  }

  case "$1" in
    init)
      shift
      [[ $# -eq 0 ]] || die "init does not accept extra arguments"
      cmd_init
      ;;
    join)
      shift
      [[ $# -ge 2 ]] || die "Usage: myos cluster join <server> <token> [--role agent|server]"
      cmd_join "$@"
      ;;
    status)
      shift
      [[ $# -eq 0 ]] || die "status does not accept extra arguments"
      cmd_status
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      die "Unknown cluster subcommand: $1"
      ;;
  esac
}

main "$@"
