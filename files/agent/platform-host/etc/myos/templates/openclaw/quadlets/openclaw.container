[Unit]
Description=OpenClaw tenant gateway for __TENANT__
After=network-online.target
Wants=network-online.target

[Container]
Image=__OPENCLAW_IMAGE__
ContainerName=openclaw-__TENANT__
AutoUpdate=registry
UserNS=keep-id
User=__TENANT_UID__:__TENANT_GID__
SecurityLabelDisable=true
Network=slirp4netns:allow_host_loopback=true
PublishPort=127.0.0.1:__OPENCLAW_PORT__:18080
PublishPort=127.0.0.1:__OPENCLAW_BRIDGE_PORT__:18790
EnvironmentFile=__TENANT_ROOT__/config/env/ports.env
EnvironmentFile=__TENANT_ROOT__/config/env/common.env
EnvironmentFile=__TENANT_ROOT__/config/env/openclaw.env
EnvironmentFile=__TENANT_ROOT__/zone-c/secrets/openclaw.secrets.env
Environment=HOME=/home/node
Environment=OPENCLAW_STATE_DIR=/home/node/.openclaw
Environment=OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_UI_PORT=18080
Volume=__TENANT_ROOT__/zone-c/state:/home/node/.openclaw:Z
Volume=__TENANT_ROOT__/zone-c/storage:/home/node/.openclaw/workspace:Z
Volume=__TENANT_ROOT__/logs:/tmp/openclaw:Z
Volume=__TENANT_ROOT__/config/rendered/openclaw-start.sh:/tmp/openclaw-start.sh:ro,Z
Volume=__TENANT_ROOT__/config/rendered/openclaw-ui-server.mjs:/tmp/openclaw-ui-server.mjs:ro,Z
Exec=sh /tmp/openclaw-start.sh

[Service]
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5s
MemoryMax=__OPENCLAW_MEMORY_MAX__
CPUQuota=__OPENCLAW_CPU_QUOTA__
TasksMax=__OPENCLAW_TASKS_MAX__

[Install]
WantedBy=default.target
