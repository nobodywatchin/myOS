# Copy to /etc/myos/ramalama/models/default.env before enabling myos-ramalama@default.service.
MODEL_REF=ollama://granite3-moe:3b
RAMALAMA_NAME=myos-default
RAMALAMA_PORT=18080
RAMALAMA_HOST=127.0.0.1
RAMALAMA_WEBUI=off
# Set to 1 only if your RamaLama release cannot bind to loopback directly and
# you have an explicit proxy or firewall plan in place.
RAMALAMA_ALLOW_WIDE_BIND=0
