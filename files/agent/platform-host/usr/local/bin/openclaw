#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

print_inactive_error() {
  cat >&2 <<'EOF'
openclaw: OpenClaw runtime is not running for this user.
Start it with: openquad start
Check status with: openquad status
EOF
}

print_not_installed_error() {
  cat >&2 <<'EOF'
openclaw: OpenClaw runtime is not installed for this user yet.
Install and start it with: openquad start
Check it with: openquad doctor
EOF
}

print_unavailable_error() {
  cat >&2 <<'EOF'
openclaw: OpenClaw runtime is unavailable.
Check it with: openquad doctor
EOF
}

if ! user_runtime_prereqs_available; then
  print_unavailable_error
  exit 1
fi

if ! user_runtime_manager_available; then
  print_unavailable_error
  exit 1
fi

if ! openclaw_user_service_installed; then
  if openclaw_user_quadlet_template_available; then
    print_not_installed_error
  else
    print_unavailable_error
  fi
  exit 1
fi

if ! user_runtime_service_active; then
  print_inactive_error
  exit 1
fi

if ! user_runtime_container_running; then
  print_unavailable_error
  exit 1
fi

readarray -d '' -t exec_args < <(user_runtime_exec_args)
exec podman "${exec_args[@]}" "$@"
