#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-configure --tenant NAME [options]

Manage the operator-facing tenant settings while keeping openclaw.json as the
runtime source of truth.

Options:
  --model MODEL                Set agents.defaults.model.primary.
  --public-hostname HOST       Set the public hostname metadata.
  --image IMAGE                Set the pinned OpenClaw image reference.
  --gateway-mode MODE          Set gateway.mode.
  --ui-auth MODE               strict or insecure.
  --set-origin ORIGIN          Add an extra allowed Control UI origin.
  --clear-extra-origins        Remove all non-loopback Control UI origins.
  --restart                    Reconcile and restart the tenant service.
  --no-restart                 Only rewrite config and rendered files.
USAGE
}

tenant=""
model=""
public_hostname=""
image=""
gateway_mode=""
ui_auth_mode=""
clear_extra_origins=0
restart_mode="auto"
set_origins=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --model)
      model="${2:-}"
      shift 2
      ;;
    --public-hostname)
      public_hostname="${2:-}"
      shift 2
      ;;
    --image)
      image="${2:-}"
      shift 2
      ;;
    --gateway-mode)
      gateway_mode="${2:-}"
      shift 2
      ;;
    --ui-auth)
      ui_auth_mode="${2:-}"
      shift 2
      ;;
    --set-origin)
      set_origins+=("${2:-}")
      shift 2
      ;;
    --clear-extra-origins)
      clear_extra_origins=1
      shift
      ;;
    --restart)
      restart_mode="yes"
      shift
      ;;
    --no-restart)
      restart_mode="no"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"
/usr/local/libexec/myos/tenant-secrets-init --tenant "$tenant"

common_env="$(tenant_env_dir "$tenant")/common.env"
openclaw_env="$(tenant_env_dir "$tenant")/openclaw.env"
config_file="$(tenant_config_file "$tenant")"
openclaw_port="$(tenant_gateway_port "$tenant")"
tailscale_origin="$(tenant_tailscale_last_origin "$tenant")"

current_public_hostname="$(env_value_from_file "$common_env" PUBLIC_HOSTNAME 2>/dev/null || true)"
current_image="$(env_value_from_file "$openclaw_env" OPENCLAW_IMAGE 2>/dev/null || true)"
readarray -t config_values < <(DEFAULT_TENANT_GATEWAY_MODE="$DEFAULT_TENANT_GATEWAY_MODE" \
DEFAULT_TENANT_PRIMARY_MODEL="$DEFAULT_TENANT_PRIMARY_MODEL" \
DEFAULT_TENANT_ALLOW_INSECURE_AUTH="$DEFAULT_TENANT_ALLOW_INSECURE_AUTH" \
python3 - "$config_file" "$openclaw_port" "$tailscale_origin" <<'PYTHON'
import json
import os
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
port = sys.argv[2]
tailscale_origin = sys.argv[3]
default_model = os.environ['DEFAULT_TENANT_PRIMARY_MODEL']
default_mode = os.environ['DEFAULT_TENANT_GATEWAY_MODE']
default_insecure = os.environ['DEFAULT_TENANT_ALLOW_INSECURE_AUTH']
default_origins = [
    f'http://127.0.0.1:{port}',
    f'http://localhost:{port}',
]

model = default_model
mode = default_mode
allow_insecure = default_insecure
extra_origins = []

try:
    with config_path.open('r', encoding='utf-8') as handle:
        data = json.load(handle)
except Exception:
    data = {}

if isinstance(data, dict):
    gateway = data.get('gateway')
    if isinstance(gateway, dict):
        value = gateway.get('mode')
        if isinstance(value, str) and value.strip():
            mode = value.strip()
        control_ui = gateway.get('controlUi')
        if isinstance(control_ui, dict):
            allow = control_ui.get('allowInsecureAuth')
            if isinstance(allow, bool):
                allow_insecure = 'true' if allow else 'false'
            origins = control_ui.get('allowedOrigins')
            if isinstance(origins, list):
                for origin in origins:
                    if not isinstance(origin, str):
                        continue
                    if origin in default_origins or origin == tailscale_origin or origin in extra_origins:
                        continue
                    extra_origins.append(origin)
    agents = data.get('agents')
    if isinstance(agents, dict):
        defaults = agents.get('defaults')
        if isinstance(defaults, dict):
            model_cfg = defaults.get('model')
            if isinstance(model_cfg, dict):
                value = model_cfg.get('primary')
                if isinstance(value, str) and value.strip():
                    model = value.strip()

print(model)
print(mode)
print(allow_insecure)
print(','.join(extra_origins))
PYTHON
)
current_model="${config_values[0]:-$DEFAULT_TENANT_PRIMARY_MODEL}"
current_gateway_mode="${config_values[1]:-$DEFAULT_TENANT_GATEWAY_MODE}"
current_ui_insecure="${config_values[2]:-$DEFAULT_TENANT_ALLOW_INSECURE_AUTH}"
current_extra_origins="${config_values[3]:-}"
current_public_hostname="${current_public_hostname:-${tenant}.example.invalid}"
current_image="${current_image:-$DEFAULT_OPENCLAW_IMAGE}"

if [ -t 0 ] && [ -z "$model$image$public_hostname$gateway_mode$ui_auth_mode" ] && [ "${#set_origins[@]}" -eq 0 ] && [ "$clear_extra_origins" -eq 0 ]; then
  printf 'Model [%s]: ' "${current_model}"
  read -r model
  printf 'Public hostname [%s]: ' "${current_public_hostname}"
  read -r public_hostname
  printf 'Image [%s]: ' "${current_image}"
  read -r image
  printf 'Gateway mode [%s]: ' "${current_gateway_mode}"
  read -r gateway_mode
  printf 'UI auth mode (strict/insecure) [%s]: ' "$( [ "$(normalize_bool "$current_ui_insecure")" = true ] && printf 'insecure' || printf 'strict' )"
  read -r ui_auth_mode
  printf 'Extra UI origins (comma-separated) [%s]: ' "$current_extra_origins"
  read -r extra_origin_input
  if [ -n "$extra_origin_input" ]; then
    IFS=',' read -r -a set_origins <<< "$extra_origin_input"
    clear_extra_origins=1
  fi
fi

model="${model:-$current_model}"
public_hostname="${public_hostname:-$current_public_hostname}"
image="${image:-$current_image}"
gateway_mode="${gateway_mode:-$current_gateway_mode}"

case "${ui_auth_mode:-}" in
  "")
    ui_auth_value="$(normalize_bool "$current_ui_insecure")"
    ;;
  strict)
    ui_auth_value=false
    ;;
  insecure)
    ui_auth_value=true
    ;;
  *)
    die "ui auth mode must be strict or insecure"
    ;;
esac

extra_origins="$current_extra_origins"
if [ "$clear_extra_origins" -eq 1 ]; then
  extra_origins=""
fi
for origin in "${set_origins[@]}"; do
  [ -n "$origin" ] || continue
  extra_origins="$(append_unique_csv_item "$extra_origins" "$origin")"
done

set_env_value "$common_env" TENANT_NAME "$tenant"
set_env_value "$common_env" PUBLIC_HOSTNAME "$public_hostname"
set_env_value "$openclaw_env" OPENCLAW_IMAGE "$image"
chown "$tenant:$tenant" "$common_env" "$openclaw_env"
chmod 0640 "$common_env" "$openclaw_env"
restorecon_if_available "$common_env" "$openclaw_env"

DEFAULT_TENANT_GATEWAY_RELOAD_MODE="$DEFAULT_TENANT_GATEWAY_RELOAD_MODE" \
python3 - "$config_file" "$openclaw_port" "$gateway_mode" "$ui_auth_value" "$model" "$extra_origins" "$tailscale_origin" <<'PYTHON'
import json
import os
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
port = sys.argv[2]
gateway_mode = sys.argv[3]
allow_insecure = sys.argv[4] == 'true'
model = sys.argv[5]
extra_csv = sys.argv[6]
tailscale_origin = sys.argv[7]
default_origins = [
    f'http://127.0.0.1:{port}',
    f'http://localhost:{port}',
]
origins = list(default_origins)
if tailscale_origin and tailscale_origin not in origins:
    origins.append(tailscale_origin)
for token in extra_csv.split(','):
    origin = token.strip()
    if origin and origin not in origins:
        origins.append(origin)

if not config_path.exists():
    data = {}
else:
    try:
        with config_path.open('r', encoding='utf-8') as handle:
            data = json.load(handle)
    except Exception as exc:
        raise SystemExit(f'openclaw.json is not strict JSON; use the raw editor or tenant-config for manual changes ({exc})')

if not isinstance(data, dict):
    data = {}

gateway = data.get('gateway')
if not isinstance(gateway, dict):
    gateway = {}
    data['gateway'] = gateway

gateway['mode'] = gateway_mode
reload_cfg = gateway.get('reload')
if not isinstance(reload_cfg, dict):
    reload_cfg = {}
    gateway['reload'] = reload_cfg
if not isinstance(reload_cfg.get('mode'), str) or not reload_cfg.get('mode', '').strip():
    reload_cfg['mode'] = os.environ['DEFAULT_TENANT_GATEWAY_RELOAD_MODE']
control_ui = gateway.get('controlUi')
if not isinstance(control_ui, dict):
    control_ui = {}
    gateway['controlUi'] = control_ui
control_ui['allowInsecureAuth'] = allow_insecure
control_ui['allowedOrigins'] = origins

agents = data.get('agents')
if not isinstance(agents, dict):
    agents = {}
    data['agents'] = agents
defaults = agents.get('defaults')
if not isinstance(defaults, dict):
    defaults = {}
    agents['defaults'] = defaults
model_cfg = defaults.get('model')
if not isinstance(model_cfg, dict):
    model_cfg = {}
    defaults['model'] = model_cfg
model_cfg['primary'] = model

with config_path.open('w', encoding='utf-8') as handle:
    json.dump(data, handle, indent=2)
    handle.write('\n')
PYTHON

chown "$tenant:$tenant" "$config_file"
chmod 0640 "$config_file"
restorecon_if_available "$config_file"

image_changed=0
public_hostname_changed=0
quadlet_missing=0

[ "$image" = "$current_image" ] || image_changed=1
[ "$public_hostname" = "$current_public_hostname" ] || public_hostname_changed=1
[ -f "$(account_quadlet_dir "$tenant")/openclaw.container" ] || quadlet_missing=1

service_active=0
if try_user_systemctl "$tenant" is-active openclaw.service; then
  service_active=1
fi

if [ "$restart_mode" = auto ]; then
  if [ "$service_active" -eq 1 ] && [ "$image_changed" -eq 1 ]; then
    restart_mode=yes
  else
    restart_mode=no
  fi
fi

if [ "$quadlet_missing" -eq 1 ] || [ "$image_changed" -eq 1 ] || [ "$public_hostname_changed" -eq 1 ]; then
  tenant_apply_config_runtime_changes "$tenant" yes "$restart_mode"
else
  tenant_apply_config_runtime_changes "$tenant" no "$restart_mode"
fi

log "updated tenant configuration for ${tenant}"
printf 'Dashboard: %s\n' "$(tenant_ui_url "$tenant")"
