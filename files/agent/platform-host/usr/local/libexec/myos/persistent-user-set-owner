#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: persistent-user-set-owner --user NAME | --clear

Assign the single owner-only persistent-user role to an existing login user.
USAGE
}

user=""
clear_owner=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    --clear)
      clear_owner=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root

if [ "$clear_owner" -eq 1 ]; then
  current_owner="$(persistent_user_owner 2>/dev/null || true)"
  if [ -n "$current_owner" ]; then
    /usr/local/libexec/myos/persistent-user-remove --user "$current_owner" --owner-only
  fi
  set_persistent_user_owner ""
  log "cleared the persistent-user owner role"
  exit 0
fi

require_existing_account "$user"
current_owner="$(persistent_user_owner 2>/dev/null || true)"

if [ "$current_owner" = "$user" ]; then
  /usr/local/libexec/myos/persistent-user-enroll --user "$user" --owner
  exit 0
fi

if [ -n "$current_owner" ]; then
  /usr/local/libexec/myos/persistent-user-remove --user "$current_owner" --owner-only
fi

set_persistent_user_owner "$user"
/usr/local/libexec/myos/persistent-user-enroll --user "$user" --owner
log "assigned the persistent-user owner role to ${user}"
