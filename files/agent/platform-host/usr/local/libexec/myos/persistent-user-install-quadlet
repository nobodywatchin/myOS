#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: persistent-user-install-quadlet --file PATH [--name NAME] [--enable] [--force]

Install a self-service Quadlet into ~/.config/containers/systemd for the
current user. Persistence across logout still requires lingering.
USAGE
}

source_file=""
target_name=""
enable_now=0
force=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --file)
      source_file="${2:-}"
      shift 2
      ;;
    --name)
      target_name="${2:-}"
      shift 2
      ;;
    --enable)
      enable_now=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -f "$source_file" ] || die "Quadlet file not found: ${source_file:-<empty>}"

target_name="${target_name:-$(basename "$source_file")}"
case "$target_name" in
  *.build|*.container|*.image|*.kube|*.network|*.pod|*.service|*.socket|*.target|*.timer|*.volume)
    ;;
  *)
    die "unsupported Quadlet or unit suffix for ${target_name}"
    ;;
esac

target_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/containers/systemd"
target_path="${target_dir}/${target_name}"
mkdir -p "$target_dir"

if [ -e "$target_path" ] && [ "$force" -ne 1 ]; then
  die "target already exists: ${target_path}; use --force to replace it"
fi

install -m 0644 "$source_file" "$target_path"
restorecon_if_available "$target_dir" "$target_path"
systemctl --user daemon-reload

unit_name="$(managed_service_unit_name_from_template "$target_path" 2>/dev/null || true)"
if [ "$enable_now" -eq 1 ]; then
  [ -n "$unit_name" ] || die "--enable is only supported for service-capable Quadlet or unit files"
  systemctl --user enable --now "$unit_name"
  log "installed and enabled ${unit_name} from ${target_path}"
elif [ -n "$unit_name" ]; then
  log "installed ${target_path}"
  printf 'Next: systemctl --user enable --now %s\n' "$unit_name"
else
  log "installed ${target_path}; reload any dependent rootless units as needed"
fi

if ! loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null | grep -qx yes; then
  warn "linger is not enabled for $(id -un); this unit will stop at logout until an admin runs: myos persistent-user-enroll --user $(id -un)"
fi
