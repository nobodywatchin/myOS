#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-list

List managed tenants, their dashboard URLs, and whether they are online.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root

if [ ! -d "$TENANT_BASE" ]; then
  printf 'No tenants found.
'
  exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf 'TENANT	STATUS	LOCAL_URL	PUBLIC_URL
' > "$tmp"
found=0

while IFS= read -r tenant; do
  [ -n "$tenant" ] || continue
  found=1

  port="$(tenant_gateway_port "$tenant" 2>/dev/null || true)"
  local_url="$(tenant_ui_url "$tenant" 2>/dev/null || printf 'unavailable')"
  public_url='-'
  exposure="$(tenant_tailscale_exposure "$tenant" 2>/dev/null || printf 'off')"
  if [ "$exposure" = serve ]; then
    public_url="$(tenant_tailscale_http_url "$tenant" 2>/dev/null || printf 'configured-but-unavailable')"
  fi

  service_active=0
  tenant_service_active "$tenant" && service_active=1

  health="$(tenant_container_health "$tenant" 2>/dev/null || printf 'unavailable')"

  status='offline'
  if [ "$service_active" -eq 1 ]; then
    if tenant_dashboard_responding "$tenant"; then
      status='online'
    elif [ "$health" = 'starting' ]; then
      status='starting'
    else
      status='degraded'
    fi
  fi

  printf '%s	%s	%s	%s
' "$tenant" "$status" "$local_url" "$public_url" >> "$tmp"
done < <(find "$TENANT_BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f
' | LC_ALL=C sort)

if [ "$found" -eq 0 ]; then
  printf 'No tenants found.
'
  exit 0
fi

if command -v column >/dev/null 2>&1; then
  column -t -s $'	' "$tmp"
else
  cat "$tmp"
fi
