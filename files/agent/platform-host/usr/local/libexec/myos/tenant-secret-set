#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-secret-set --tenant NAME [--key KEY] [--value VALUE] [--rotate-gateway-token] [--restart|--no-restart]

Set or rotate a tenant secret without editing files manually.
USAGE
}

is_allowed_secret_key() {
  case "$1" in
    OPENCLAW_GATEWAY_TOKEN|OPENROUTER_API_KEY|OPENAI_API_KEY|ANTHROPIC_API_KEY|GROQ_API_KEY|OLLAMA_API_KEY)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

tenant=""
key=""
value=""
restart_mode="auto"
rotate_gateway_token=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --key)
      key="${2:-}"
      shift 2
      ;;
    --value)
      value="${2:-}"
      shift 2
      ;;
    --rotate-gateway-token)
      rotate_gateway_token=1
      shift
      ;;
    --restart)
      restart_mode="yes"
      shift
      ;;
    --no-restart)
      restart_mode="no"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

if [ "$rotate_gateway_token" -eq 1 ]; then
  key=OPENCLAW_GATEWAY_TOKEN
  value="$(generate_secret_value)"
fi

if [ -z "$key" ] && [ -t 0 ]; then
  printf 'Secret key [OPENROUTER_API_KEY/OPENAI_API_KEY/ANTHROPIC_API_KEY/GROQ_API_KEY/OLLAMA_API_KEY/OPENCLAW_GATEWAY_TOKEN]: '
  read -r key
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"
is_allowed_secret_key "$key" || die "unsupported secret key: ${key:-<empty>}"

if [ -z "$value" ]; then
  if [ ! -t 0 ]; then
    value="$(cat)"
  else
    printf 'Value for %s: ' "$key"
    read -r -s value
    printf '\n'
  fi
fi

[ -n "$value" ] || die "secret value for ${key} may not be empty"

/usr/local/libexec/myos/tenant-secrets-init --tenant "$tenant"
secret_file="$(tenant_secret_file "$tenant")"
set_env_value "$secret_file" "$key" "$value"
chown "$tenant:$tenant" "$secret_file"
chmod 0600 "$secret_file"
restorecon_if_available "$secret_file"

service_active=0
if try_user_systemctl "$tenant" is-active openclaw.service; then
  service_active=1
fi

if [ "$restart_mode" = auto ]; then
  if [ "$service_active" -eq 1 ]; then
    restart_mode=yes
  else
    restart_mode=no
  fi
fi

if [ "$restart_mode" = yes ]; then
  restart_tenant_openclaw_service "$tenant"
  /usr/local/libexec/myos/tenant-validate --tenant "$tenant" --require-running
fi

log "updated ${key} for ${tenant}"
