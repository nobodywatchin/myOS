#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: persistent-user-remove --user NAME [--owner-only] [--disable-linger]

Remove myOS-managed persistent-user units for an enrolled login user.
USAGE
}

user=""
owner_only=0
disable_linger=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    --owner-only)
      owner_only=1
      shift
      ;;
    --disable-linger)
      disable_linger=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
require_existing_account "$user"

uid="$(id -u "$user")"
remove_units_file="$(mktemp)"
remove_files_file="$(mktemp)"
trap 'rm -f "$remove_units_file" "$remove_files_file"' EXIT

collect_role_state() {
  local role="$1"
  local files_state units_state

  files_state="$(persistent_user_role_files_file "$user" "$role")"
  units_state="$(persistent_user_role_units_file "$user" "$role")"

  if [ -f "$units_state" ]; then
    cat "$units_state" >> "$remove_units_file"
  fi

  if [ -f "$files_state" ]; then
    cat "$files_state" >> "$remove_files_file"
  fi

  rm -f "$files_state" "$units_state"
}

if [ "$owner_only" -eq 1 ]; then
  collect_role_state owner
else
  collect_role_state baseline
  collect_role_state owner
fi

sort -u "$remove_units_file" -o "$remove_units_file"
sort -u "$remove_files_file" -o "$remove_files_file"

if [ -s "$remove_units_file" ]; then
  if ! try_user_systemctl "$user" daemon-reload; then
    systemctl start "user@${uid}.service"
  fi

  mapfile -t remove_units < "$remove_units_file"
  run_user_systemctl "$user" disable --now "${remove_units[@]}" || true
fi

if [ -s "$remove_files_file" ]; then
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    rm -f "$target"
  done < "$remove_files_file"
fi

if try_user_systemctl "$user" daemon-reload; then
  :
elif [ -s "$remove_units_file" ] || [ -s "$remove_files_file" ]; then
  systemctl start "user@${uid}.service"
  run_user_systemctl "$user" daemon-reload || true
fi

if persistent_user_is_owner "$user"; then
  set_persistent_user_owner ""
fi

if [ "$disable_linger" -eq 1 ] && [ "$owner_only" -eq 0 ]; then
  loginctl disable-linger "$user" >/dev/null 2>&1 || true
fi

if [ "$owner_only" -eq 1 ]; then
  log "removed owner-only persistent units for ${user}"
else
  log "removed managed persistent-user units for ${user}"
fi
