#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-validate --tenant NAME [--require-running]

Run preflight and runtime checks for a tenant.
USAGE
}

pass() {
  printf '[PASS] %s
' "$*"
}

note() {
  printf '[INFO] %s
' "$*"
}

check_warn() {
  printf '[WARN] %s
' "$*"
  warnings=$((warnings + 1))
}

check_fail() {
  printf '[FAIL] %s
' "$*"
  failures=$((failures + 1))
}

required_secret_for_model() {
  case "$1" in
    openrouter/*) printf 'OPENROUTER_API_KEY
' ;;
    openai/*) printf 'OPENAI_API_KEY
' ;;
    anthropic/*) printf 'ANTHROPIC_API_KEY
' ;;
    groq/*) printf 'GROQ_API_KEY
' ;;
    *) printf '
' ;;
  esac
}

tenant=""
require_running=0
failures=0
warnings=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --require-running)
      require_running=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"

if getent passwd "$tenant" >/dev/null 2>&1; then
  pass "tenant user ${tenant} exists"
else
  check_fail "tenant user ${tenant} does not exist"
fi

home="$(tenant_home "$tenant")"
state_dir="$(tenant_state_dir "$tenant")"
storage_dir="$(tenant_root "$tenant")/zone-c/storage"
secret_file="$(tenant_secret_file "$tenant")"
config_file="$(tenant_config_file "$tenant")"
openclaw_env="$(tenant_env_dir "$tenant")/openclaw.env"
common_env="$(tenant_env_dir "$tenant")/common.env"
ports_env="$(tenant_env_dir "$tenant")/ports.env"
rendered_dir="$(tenant_rendered_dir "$tenant")"
graphroot="$(tenant_podman_graphroot "$tenant")"
container_name="$(tenant_container_name "$tenant")"
rendered_unit="$(tenant_home "$tenant")/.config/containers/systemd/openclaw.container"
openclaw_port="$(env_value_from_file "$ports_env" OPENCLAW_PORT 2>/dev/null || true)"
bridge_port="$(env_value_from_file "$ports_env" OPENCLAW_BRIDGE_PORT 2>/dev/null || true)"
tailscale_exposure="$(tenant_tailscale_exposure "$tenant")"

for path in "$home" "$state_dir" "$storage_dir" "$graphroot"; do
  if [ -d "$path" ]; then
    pass "path present: $path"
  else
    check_fail "missing directory: $path"
  fi
done

for path in "$ports_env" "$common_env" "$openclaw_env" "$secret_file" "$config_file" "$rendered_unit" "$rendered_dir/openclaw-start.sh"; do
  if [ -f "$path" ]; then
    pass "file present: $path"
  else
    check_fail "missing file: $path"
  fi
done

if [ -f "$home/.config/containers/storage.conf" ]; then
  storage_graphroot="$(awk -F= '/^[[:space:]]*graphroot[[:space:]]*=/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); gsub(/^"|"$/, "", $2); print $2; exit}' "$home/.config/containers/storage.conf" 2>/dev/null || true)"
  if [ "$storage_graphroot" = "$graphroot" ]; then
    pass "tenant Podman graphroot is pinned to ${graphroot}"
  elif [ -n "$storage_graphroot" ]; then
    check_fail "storage.conf points at ${storage_graphroot}, expected ${graphroot}"
  else
    check_fail "storage.conf does not declare graphroot ${graphroot}"
  fi
else
  check_fail "missing storage.conf under tenant home"
fi

if [ -f "$secret_file" ]; then
  gateway_token="$(env_value_from_file "$secret_file" OPENCLAW_GATEWAY_TOKEN 2>/dev/null || true)"
  if [ -n "$gateway_token" ]; then
    pass "gateway token is configured"
  else
    check_fail "gateway token is missing"
  fi
fi

config_validate_output="$(run_tenant_openclaw_cli "$tenant" config validate --json 2>&1 || true)"
if run_tenant_openclaw_cli "$tenant" config validate --json >/dev/null 2>&1; then
  pass "OpenClaw config validates successfully"
else
  check_fail "OpenClaw config validation failed: $(printf '%s
' "$config_validate_output" | tail -n 1)"
fi

model="$(tenant_primary_model_from_config "$tenant" 2>/dev/null || true)"
if [ -z "$model" ]; then
  model="$(run_tenant_openclaw_cli "$tenant" config get agents.defaults.model.primary 2>/dev/null | tail -n 1 || true)"
fi
required_secret="$(required_secret_for_model "$model")"
if [ -n "$required_secret" ]; then
  provider_value="$(env_value_from_file "$secret_file" "$required_secret" 2>/dev/null || true)"
  if [ -n "$provider_value" ]; then
    pass "required provider secret ${required_secret} is configured for ${model}"
  else
    check_fail "required provider secret ${required_secret} is missing for ${model}"
  fi
else
  check_warn "could not infer a required provider secret from model ${model:-<unset>}"
fi

if loginctl show-user "$tenant" -p Linger --value 2>/dev/null | grep -qx yes; then
  pass "linger is enabled for ${tenant}"
else
  check_warn "linger is not enabled for ${tenant}"
fi

if tenant_systemd_reachable "$tenant"; then
  pass "tenant user systemd is reachable"
else
  check_fail "tenant user systemd is not reachable"
fi

if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = Enforcing ]; then
  if grep -q '^SecurityLabelDisable=true$' "$rendered_unit" 2>/dev/null; then
    check_warn "SELinux compatibility mode is enabled via SecurityLabelDisable=true"
  fi
fi

service_active=0
if tenant_service_active "$tenant"; then
  service_active=1
  pass "openclaw.service is active"
else
  if [ "$require_running" -eq 1 ]; then
    check_fail "openclaw.service is not active"
  else
    note "openclaw.service is not active; skipping live checks"
  fi
fi

if [ "$service_active" -eq 1 ]; then
  if tenant_container_exists "$tenant"; then
    health="$(tenant_container_health "$tenant" 2>/dev/null || true)"
    status="$(tenant_container_state "$tenant")"
    [ "$status" = running ] && pass "container ${container_name} is running" || check_fail "container ${container_name} state is ${status:-unknown}"
    case "$health" in
      healthy|unknown)
        pass "container health is ${health}"
        ;;
      *)
        check_fail "container health is ${health:-unavailable}"
        ;;
    esac
  else
    check_fail "container ${container_name} is not present"
  fi

  for port in "$openclaw_port" "$bridge_port"; do
    if [ -n "$port" ] && ss -Hltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|[:\]])${port}$"; then
      pass "port ${port} is listening"
    else
      check_fail "port ${port:-<unset>} is not listening"
    fi
  done

  if tenant_dashboard_responding "$tenant"; then
    pass "dashboard endpoint responds on ${openclaw_port}"
  else
    check_fail "dashboard endpoint is not responding on ${openclaw_port:-<unset>}"
  fi
fi

if [ "$tailscale_exposure" = serve ]; then
  if tailscale_installed; then
    pass "tailscale CLI is installed"
  else
    check_fail "tailscale CLI is not installed on the host"
  fi

  if tailscale_service_active; then
    pass "tailscaled.service is active"
  else
    check_fail "tailscaled.service is not active"
  fi

  tailscale_dns="$(tailscale_self_dns_name 2>/dev/null || true)"
  if [ -n "$tailscale_dns" ]; then
    pass "tailscale node is logged in as ${tailscale_dns}"
  else
    check_fail "tailscale is not logged in or does not have a MagicDNS name"
  fi

  if [ "$service_active" -eq 1 ] && [ -n "$tailscale_dns" ] && [ -n "$openclaw_port" ]; then
    tailscale_origin="https://${tailscale_dns}:${openclaw_port}"
    tailscale_pairing_url="${tailscale_origin}/"
    if tenant_control_ui_has_origin "$tenant" "$tailscale_origin"; then
      pass "tailscale Control UI origin ${tailscale_origin} is configured"
    else
      check_fail "tailscale Control UI origin ${tailscale_origin} is missing from openclaw.json"
    fi

    configured_pairing_url="$(tenant_device_pair_public_url "$tenant" 2>/dev/null || true)"
    if [ "$configured_pairing_url" = "$tailscale_pairing_url" ]; then
      pass "device-pair publicUrl is configured as ${tailscale_pairing_url}"
    else
      check_fail "device-pair publicUrl is ${configured_pairing_url:-unset}, expected ${tailscale_pairing_url}"
    fi
  elif [ -n "$tailscale_dns" ] && [ -n "$openclaw_port" ]; then
    note "tenant service is inactive; deferring live Tailscale origin and pairing URL verification until after start"
  fi

  if [ "$service_active" -eq 1 ] && [ -n "$openclaw_port" ] && tailscale_serve_has_mapping "$openclaw_port" "http://127.0.0.1:${openclaw_port}"; then
    pass "tailscale serve maps ${openclaw_port} to the tenant gateway"
  elif [ "$service_active" -eq 1 ]; then
    check_fail "tailscale serve is missing the expected mapping for ${openclaw_port:-<unset>}"
  else
    note "tenant service is inactive; deferring live Tailscale serve verification until after start"
  fi
fi

printf 'Dashboard: %s
' "$(tenant_ui_url "$tenant" 2>/dev/null || printf 'unavailable')"
printf 'Gateway: %s
' "$(tenant_gateway_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
if [ "$tailscale_exposure" = serve ]; then
  printf 'Tailscale dashboard: %s
' "$(tenant_tailscale_http_url "$tenant" 2>/dev/null || printf 'unavailable')"
  printf 'Tailscale gateway: %s
' "$(tenant_tailscale_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
fi
printf 'Pairing public URL: %s
' "$(tenant_device_pair_public_url "$tenant" 2>/dev/null || printf 'unconfigured')"

if [ "$failures" -gt 0 ]; then
  exit 1
fi
