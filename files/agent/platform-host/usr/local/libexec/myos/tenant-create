#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-create --tenant NAME [--no-linger] [--start] [configuration options]

Create a hosted tenant through the supported operator workflow.
This is the normal bootstrap entry point; it handles the lower-level tenant
scaffold and reconcile steps for you.
USAGE
}

tenant=""
enable_linger=1
start_after=0
configure_args=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --no-linger)
      enable_linger=0
      shift
      ;;
    --start)
      start_after=1
      shift
      ;;
    --model|--public-hostname|--image|--gateway-mode|--ui-auth|--set-origin)
      configure_args+=("$1" "${2:-}")
      shift 2
      ;;
    --clear-extra-origins)
      configure_args+=("$1")
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"

init_args=(--tenant "$tenant" --force-quadlets)
if [ "$enable_linger" -eq 1 ]; then
  init_args+=(--enable-linger)
fi
/usr/local/libexec/myos/tenant-init "${init_args[@]}"

common_env="$(tenant_env_dir "$tenant")/common.env"
set_env_value "$common_env" TENANT_NAME "$tenant"
if [ -z "$(env_value_from_file "$common_env" PUBLIC_HOSTNAME 2>/dev/null || true)" ]; then
  set_env_value "$common_env" PUBLIC_HOSTNAME "${tenant}.example.invalid"
fi
if [ -z "$(env_value_from_file "$common_env" TAILSCALE_EXPOSURE 2>/dev/null || true)" ]; then
  set_env_value "$common_env" TAILSCALE_EXPOSURE off
fi
if ! grep -q '^TAILSCALE_LAST_ORIGIN=' "$common_env" 2>/dev/null; then
  set_env_value "$common_env" TAILSCALE_LAST_ORIGIN ""
fi
chown "$tenant:$tenant" "$common_env"
chmod 0640 "$common_env"
restorecon_if_available "$common_env"
/usr/local/libexec/myos/tenant-config-render --tenant "$tenant"

if [ "${#configure_args[@]}" -gt 0 ]; then
  /usr/local/libexec/myos/tenant-configure --tenant "$tenant" --no-restart "${configure_args[@]}"
fi

if [ "$start_after" -eq 1 ]; then
  /usr/local/libexec/myos/tenant-start --tenant "$tenant"
  printf 'Dashboard: %s
' "$(tenant_ui_url "$tenant")"
else
  log "tenant ${tenant} is ready for secret entry and startup"
  printf 'Next: myos tenant-secret-set --tenant %s --key OPENROUTER_API_KEY
' "$tenant"
  printf 'Then: myos tenant-start --tenant %s
' "$tenant"
  printf 'Optional: myos tenant-tailscale enable --tenant %s
' "$tenant"
  printf 'Then: myos tenant-dashboard --tenant %s --no-open
' "$tenant"
fi
