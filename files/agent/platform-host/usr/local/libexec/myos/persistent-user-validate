#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: persistent-user-validate --user NAME

Validate lingering, managed state files, and enabled user units for an enrolled
persistent login user.
USAGE
}

pass() {
  printf '[PASS] %s\n' "$*"
}

note() {
  printf '[INFO] %s\n' "$*"
}

check_warn() {
  printf '[WARN] %s\n' "$*"
  warnings=$((warnings + 1))
}

check_fail() {
  printf '[FAIL] %s\n' "$*"
  failures=$((failures + 1))
}

user=""
failures=0
warnings=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --user)
      user="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
require_existing_account "$user"

home="$(account_home "$user")"
quadlet_dir="$(account_quadlet_dir "$user")"
owner_assigned=0
if persistent_user_is_owner "$user"; then
  owner_assigned=1
fi

pass "login user ${user} exists"
if [ -d "$home" ]; then
  pass "home directory present: $home"
else
  check_fail "missing home directory: $home"
fi

if [ -d "$quadlet_dir" ]; then
  pass "user Quadlet directory present: $quadlet_dir"
else
  check_fail "missing user Quadlet directory: $quadlet_dir"
fi

if grep -q "^${user}:" /etc/subuid 2>/dev/null; then
  pass "subuid range is present for ${user}"
else
  check_fail "subuid range is missing for ${user}"
fi

if grep -q "^${user}:" /etc/subgid 2>/dev/null; then
  pass "subgid range is present for ${user}"
else
  check_fail "subgid range is missing for ${user}"
fi

if loginctl show-user "$user" -p Linger --value 2>/dev/null | grep -qx yes; then
  pass "linger is enabled for ${user}"
else
  check_warn "linger is not enabled for ${user}"
fi

if try_user_systemctl "$user" show-environment; then
  pass "user systemd is reachable for ${user}"
else
  check_fail "user systemd is not reachable for ${user}"
fi

check_role() {
  local role="$1"
  local expected="$2"
  local files_state units_state target unit

  files_state="$(persistent_user_role_files_file "$user" "$role")"
  units_state="$(persistent_user_role_units_file "$user" "$role")"

  if [ ! -f "$files_state" ] || [ ! -f "$units_state" ]; then
    if [ "$expected" -eq 1 ]; then
      check_fail "missing managed state for ${role} role"
    else
      note "${role} role is not configured for ${user}"
    fi
    return 0
  fi

  pass "managed state present for ${role} role"

  if [ -s "$files_state" ]; then
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      if [ -f "$target" ]; then
        pass "managed file present: $target"
      else
        check_fail "managed file missing: $target"
      fi
    done < "$files_state"
  else
    note "no managed template files are currently defined for ${role} role"
  fi

  if [ -s "$units_state" ]; then
    while IFS= read -r unit; do
      [ -n "$unit" ] || continue
      if try_user_systemctl "$user" is-enabled "$unit"; then
        pass "managed unit enabled: $unit"
      else
        check_warn "managed unit is not enabled: $unit"
      fi
    done < "$units_state"
  else
    note "no service-enabled units are currently defined for ${role} role"
  fi
}

check_role baseline 1
check_role owner "$owner_assigned"

if [ "$owner_assigned" -eq 1 ]; then
  pass "owner role is assigned to ${user}"
else
  note "owner role is not assigned to ${user}"
fi

printf 'Self-service Quadlets: %s\n' "$quadlet_dir"
printf 'Owner assignment: %s\n' "$(persistent_user_owner 2>/dev/null || printf 'unset')"

if [ "$failures" -gt 0 ]; then
  exit 1
fi
