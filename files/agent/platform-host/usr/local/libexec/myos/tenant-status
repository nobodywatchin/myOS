#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-status --tenant NAME [--show-token]

Show hosted tenant health, endpoints, and recent logs.
USAGE
}

tenant=""
show_token=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --show-token)
      show_token=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

ports_env="$(tenant_env_dir "$tenant")/ports.env"
common_env="$(tenant_env_dir "$tenant")/common.env"
openclaw_env="$(tenant_env_dir "$tenant")/openclaw.env"
secret_file="$(tenant_secret_file "$tenant")"
container_name="$(tenant_container_name "$tenant")"
openclaw_port="$(env_value_from_file "$ports_env" OPENCLAW_PORT 2>/dev/null || true)"
bridge_port="$(env_value_from_file "$ports_env" OPENCLAW_BRIDGE_PORT 2>/dev/null || true)"

tailscale_exposure="$(tenant_tailscale_exposure "$tenant")"
tailscale_dashboard="disabled"
tailscale_ws="disabled"
tailscale_mapping="disabled"
if [ "$tailscale_exposure" = serve ]; then
  tailscale_dashboard="$(tenant_tailscale_http_url "$tenant" 2>/dev/null || printf 'unavailable')"
  tailscale_ws="$(tenant_tailscale_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
  if [ -n "$openclaw_port" ] && tailscale_serve_has_mapping "$openclaw_port" "http://127.0.0.1:${openclaw_port}" 2>/dev/null; then
    tailscale_mapping="configured"
  else
    tailscale_mapping="missing"
  fi
fi

service_state="$(tenant_service_active_state "$tenant")"
service_state="${service_state:-inactive}"

container_health="$(tenant_container_health "$tenant" 2>/dev/null || printf 'unavailable')"

primary_model="$(tenant_primary_model_from_config "$tenant" 2>/dev/null || printf 'unset')"
public_hostname="$(env_value_from_file "$common_env" PUBLIC_HOSTNAME 2>/dev/null || true)"
public_hostname="${public_hostname:-${tenant}.example.invalid}"

gateway_token="$(env_value_from_file "$secret_file" OPENCLAW_GATEWAY_TOKEN 2>/dev/null || true)"
pairing_public_url="$(tenant_device_pair_public_url "$tenant" 2>/dev/null || true)"
models_status="$(tenant_models_status_plain "$tenant")"

printf 'Tenant: %s
' "$tenant"
printf 'Service: %s
' "$service_state"
printf 'Container health: %s
' "$container_health"
printf 'Image: %s
' "$(env_value_from_file "$openclaw_env" OPENCLAW_IMAGE 2>/dev/null || printf 'unset')"
printf 'Primary model: %s
' "$primary_model"
printf 'Public hostname: %s
' "$public_hostname"
printf 'Dashboard: %s
' "$(tenant_ui_url "$tenant" 2>/dev/null || printf 'unavailable')"
printf 'Gateway WebSocket: %s
' "$(tenant_gateway_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
printf 'OpenClaw port: %s
' "${openclaw_port:-unset}"
printf 'Bridge port: %s
' "${bridge_port:-unset}"
printf 'Gateway token: %s
' "$(if [ -n "$gateway_token" ]; then printf 'configured'; else printf 'missing'; fi)"
printf 'Pairing public URL: %s
' "${pairing_public_url:-unset}"
if [ "$show_token" -eq 1 ]; then
  printf 'Gateway token value: %s
' "${gateway_token:-missing}"
fi
printf 'Tailscale exposure: %s
' "$tailscale_exposure"
if [ "$tailscale_exposure" = serve ]; then
  printf 'Tailscale dashboard: %s
' "$tailscale_dashboard"
  printf 'Tailscale WebSocket: %s
' "$tailscale_ws"
  printf 'Tailscale mapping: %s
' "$tailscale_mapping"
  printf 'Pairing hint: myos tenant-openclaw --tenant %s qr
' "$tenant"
fi

if [ -n "$models_status" ]; then
  printf '
Model status:
%s
' "$models_status"
fi

printf '
Recent logs:
'
run_tenant_podman "$tenant" logs --tail 10 "$container_name" 2>/dev/null || printf 'No container logs available.
'
