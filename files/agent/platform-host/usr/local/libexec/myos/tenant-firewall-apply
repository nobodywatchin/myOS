#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-firewall-apply --tenant NAME

Internal reconciliation helper.
Use `tenant-create`, `tenant-configure`, or `tenant-tailscale` for the
supported operator-facing flow.

Render future firewall and proxy integration notes for a tenant. This script
does not open ports by default.
USAGE
}

tenant=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

if [ ! -f "$(tenant_env_dir "$tenant")/ports.env" ]; then
  /usr/local/libexec/myos/tenant-port-allocate --tenant "$tenant"
fi

# shellcheck disable=SC1090
. "$(tenant_env_dir "$tenant")/ports.env"

ensure_dir 0755 root root "/etc/myos/firewall/rendered"
write_if_missing 0640 root root "/etc/myos/firewall/tenant-egress.env.example" "/etc/myos/firewall/tenants/${tenant}.env"

cat > "/etc/myos/firewall/rendered/${tenant}.plan" <<EOF_PLAN
# myOS tenant firewall scaffold for ${tenant}
#
# No public tenant ports are opened by default.
# Shared ingress should terminate on nginx and proxy only:
#   OpenClaw gateway: http://127.0.0.1:${OPENCLAW_PORT}
#
# The OpenClaw bridge stays on loopback only:
#   OpenClaw bridge: http://127.0.0.1:${OPENCLAW_BRIDGE_PORT}
#
# Future egress controls belong in:
#   /etc/myos/firewall/tenants/${tenant}.env
#
# Future DNS policy belongs in:
#   $(tenant_env_dir "$tenant")/dns.env
EOF_PLAN

chmod 0640 "/etc/myos/firewall/rendered/${tenant}.plan"
restorecon_if_available "/etc/myos/firewall/rendered/${tenant}.plan" "/etc/myos/firewall/tenants/${tenant}.env"

log "rendered firewall scaffold for ${tenant}; no live rules were changed"
