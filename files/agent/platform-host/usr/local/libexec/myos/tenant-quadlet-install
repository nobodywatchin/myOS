#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-quadlet-install --tenant NAME [--force] [--restart] [--validate]

Render rootless Quadlet files into the tenant home directory and optionally
reconcile the running tenant service.
USAGE
}

tenant=""
force=0
restart_service=0
validate_after=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --force)
      force=1
      shift
      ;;
    --restart)
      restart_service=1
      shift
      ;;
    --validate)
      validate_after=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

TENANT="$tenant"
TENANT_ROOT="$(tenant_root "$tenant")"
TENANT_HOME="$(tenant_home "$tenant")"
TENANT_RENDERED_DIR="$(tenant_rendered_dir "$tenant")"
TENANT_UID="$(id -u "$tenant")"
TENANT_GID="$(id -g "$tenant")"
quadlet_files_changed=0

render_tenant_file_if_needed() {
  local template="$1"
  local target="$2"
  local mode="$3"
  local owner="$4"
  local group="$5"
  local changed_var="$6"
  local tmp

  tmp="$(mktemp)"
  render_template_file "$template" "$tmp"

  if [ -e "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    return 1
  fi

  install -D -m "$mode" -o "$owner" -g "$group" "$tmp" "$target"
  rm -f "$tmp"
  restorecon_if_available "$target"
  printf -v "$changed_var" 1
}

if [ ! -f "$(tenant_env_dir "$tenant")/ports.env" ]; then
  /usr/local/libexec/myos/tenant-port-allocate --tenant "$tenant"
fi

/usr/local/libexec/myos/tenant-secrets-init --tenant "$tenant"
/usr/local/libexec/myos/tenant-config-render --tenant "$tenant"

# shellcheck disable=SC1090
. "$(tenant_env_dir "$tenant")/ports.env"
# shellcheck disable=SC1090
. "$(tenant_env_dir "$tenant")/common.env"
# shellcheck disable=SC1090
. "$(tenant_env_dir "$tenant")/openclaw.env"

PUBLIC_HOSTNAME="${PUBLIC_HOSTNAME:-${tenant}.example.invalid}"
OPENCLAW_BRIDGE_PORT="${OPENCLAW_BRIDGE_PORT:-${CONTROL_PORT:-}}"
OPENCLAW_MEMORY_MAX="${OPENCLAW_MEMORY_MAX:-4G}"
OPENCLAW_CPU_QUOTA="${OPENCLAW_CPU_QUOTA:-200%}"
OPENCLAW_TASKS_MAX="${OPENCLAW_TASKS_MAX:-512}"

case "${OPENCLAW_IMAGE:-}" in
  ""|"registry.example.invalid/openclaw/runtime:stable"|"YOUR_REGISTRY/openclaw/runtime:stable"|"ghcr.io/openclaw/openclaw:latest")
    OPENCLAW_IMAGE="$DEFAULT_OPENCLAW_IMAGE"
    ;;
esac

ensure_dir 0750 "$tenant" "$tenant" "${TENANT_HOME}/.config"
ensure_dir 0750 "$tenant" "$tenant" "${TENANT_HOME}/.config/containers"
ensure_dir 0750 "$tenant" "$tenant" "${TENANT_HOME}/.config/containers/systemd"
ensure_dir 0750 "$tenant" "$tenant" "${TENANT_RENDERED_DIR}"

rm -f \
  "${TENANT_HOME}/.config/containers/systemd/openclaw-stack.pod" \
  "${TENANT_HOME}/.config/containers/systemd/browser-zone.container" \
  "${TENANT_HOME}/.config/containers/systemd/zone-a-agent.container" \
  "${TENANT_HOME}/.config/containers/systemd/zone-b-parser.container"

while read -r template; do
  target="${TENANT_HOME}/.config/containers/systemd/$(basename "$template")"
  if [ "$force" -eq 0 ] && [ -e "$target" ]; then
    continue
  fi

  render_tenant_file_if_needed "$template" "$target" 0640 "$tenant" "$tenant" quadlet_files_changed || true
done < <(find "${TEMPLATE_BASE}/quadlets" -maxdepth 1 -type f \( -name '*.pod' -o -name '*.container' \) | sort)

while read -r template; do
  target="${TENANT_RENDERED_DIR}/$(basename "$template")"
  if [ "$force" -eq 0 ] && [ -e "$target" ]; then
    continue
  fi

  render_tenant_file_if_needed "$template" "$target" 0640 "$tenant" "$tenant" _unused_change_flag || true
done < <(find "${TEMPLATE_BASE}/scripts" -maxdepth 1 -type f | sort)
proxy_target="/etc/myos/proxy/tenants/${tenant}.conf.example"
if [ "$force" -eq 1 ] || [ ! -e "$proxy_target" ]; then
  render_tenant_file_if_needed "${TEMPLATE_BASE}/proxy/tenant-route.nginx.conf.example" "$proxy_target" 0644 root root _unused_change_flag || true
fi

restorecon_if_available "${TENANT_HOME}/.config/containers/systemd" "${TENANT_RENDERED_DIR}"

if [ "$quadlet_files_changed" -eq 1 ]; then
  if try_user_systemctl "$tenant" daemon-reload; then
    log "reloaded user systemd for ${tenant}"
  else
    if [ "$restart_service" -eq 1 ] || [ "$validate_after" -eq 1 ]; then
      systemctl start "user@${TENANT_UID}.service"
      run_user_systemctl "$tenant" daemon-reload
      log "reloaded user systemd for ${tenant}"
    else
      warn "could not reach the user systemd instance for ${tenant}; run systemctl --user daemon-reload after enabling linger or logging in"
    fi
  fi
fi

if [ "$restart_service" -eq 1 ]; then
  restart_tenant_openclaw_service "$tenant"
  log "restarted OpenClaw service for ${tenant}"
fi

log "rendered OpenClaw tenant Quadlets for ${tenant}"

if [ "$validate_after" -eq 1 ]; then
  /usr/local/libexec/myos/tenant-validate --tenant "$tenant" --require-running
fi
