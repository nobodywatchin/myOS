#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-dashboard --tenant NAME [--no-open]

Print the tenant dashboard URL using the upstream OpenClaw dashboard command.
USAGE
}

tenant=""
no_open=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --no-open)
      no_open=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

port="$(tenant_gateway_port "$tenant")"
output="$(run_tenant_openclaw_cli "$tenant" dashboard --no-open 2>&1)" || die "$output"
rewritten="$(printf '%s\n' "$output" | sed -e "s#127.0.0.1:18789#127.0.0.1:${port}#g" -e "s#localhost:18789#localhost:${port}#g")"
url="$(printf '%s\n' "$rewritten" | grep -Eo 'https?://[^[:space:]]+' | tail -n 1 || true)"

printf '%s\n' "$rewritten"

if [ "$no_open" -eq 0 ]; then
  if [ -z "$url" ]; then
    url="$(tenant_ui_url "$tenant" 2>/dev/null || true)"
  fi

  if [ -n "$url" ] && command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || warn "failed to open dashboard URL automatically"
  elif [ -n "$url" ]; then
    warn "xdg-open is unavailable; open ${url} manually"
  fi
fi
