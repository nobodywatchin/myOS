#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-secret-import --tenant NAME [--from-env-file PATH] [--restart|--no-restart]

Import tenant secrets from an env file or stdin.
USAGE
}

is_allowed_secret_key() {
  case "$1" in
    OPENCLAW_GATEWAY_TOKEN|OPENROUTER_API_KEY|OPENAI_API_KEY|ANTHROPIC_API_KEY|GROQ_API_KEY|OLLAMA_API_KEY)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

tenant=""
from_env_file=""
restart_mode="auto"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --from-env-file)
      from_env_file="${2:-}"
      shift 2
      ;;
    --restart)
      restart_mode="yes"
      shift
      ;;
    --no-restart)
      restart_mode="no"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

input_file=""
temp_input=0
cleanup() {
  if [ "$temp_input" -eq 1 ] && [ -n "$input_file" ]; then
    rm -f "$input_file"
  fi
}
trap cleanup EXIT

if [ -n "$from_env_file" ]; then
  [ -f "$from_env_file" ] || die "env file not found: $from_env_file"
  input_file="$from_env_file"
elif [ ! -t 0 ]; then
  input_file="$(mktemp)"
  temp_input=1
  cat > "$input_file"
else
  die "provide --from-env-file or pipe env content on stdin"
fi

/usr/local/libexec/myos/tenant-secrets-init --tenant "$tenant"
secret_file="$(tenant_secret_file "$tenant")"
updated=0

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ''|'#'*)
      continue
      ;;
  esac

  case "$line" in
    *=*)
      ;;
    *)
      die "malformed env line: $line"
      ;;
  esac

  key="${line%%=*}"
  value="${line#*=}"
  [ -n "$key" ] || die "malformed env line: $line"
  is_allowed_secret_key "$key" || die "unsupported secret key: $key"
  [ -n "$value" ] || die "secret value for ${key} may not be empty"
  set_env_value "$secret_file" "$key" "$value"
  updated=$((updated + 1))
done < "$input_file"

[ "$updated" -gt 0 ] || die "no secret values were imported"

chown "$tenant:$tenant" "$secret_file"
chmod 0600 "$secret_file"
restorecon_if_available "$secret_file"

service_active=0
if try_user_systemctl "$tenant" is-active openclaw.service; then
  service_active=1
fi

if [ "$restart_mode" = auto ]; then
  if [ "$service_active" -eq 1 ]; then
    restart_mode=yes
  else
    restart_mode=no
  fi
fi

if [ "$restart_mode" = yes ]; then
  /usr/local/libexec/myos/tenant-quadlet-install --tenant "$tenant" --force --restart --validate
fi

log "imported ${updated} tenant secrets for ${tenant}"
