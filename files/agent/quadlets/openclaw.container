[Unit]
Description=OpenClaw Primary Agent (per-user)
After=graphical-session.target
Requires=graphical-session.target
PartOf=graphical-session.target

[Container]
# TODO: pin to a stable tag later (e.g. :stable)
Image=ghcr.io/openclaw/openclaw:latest
ContainerName=openclaw

# Hardening - critical for the self-modifying feedback loop
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:size=512M,mode=1777
SecurityOpts=seccomp=unconfined

# Resource limits - prevents OpenClaw from consuming the whole machine
CPUQuota=200%
MemoryHigh=2G
MemoryMax=3G

# Network
Network=slirp4netns

# Explicit volumes only - very important for safety
Volume=%t/containers/storage:/var/lib/containers/storage:rw
Volume=%h/.config/myos:/home/openclaw/.config/myos:rw
Volume=/srv/tenants/openclaw:/srv/tenants/openclaw:rw

# GitHub token (mounted via tenant secret system)
Secret=gh-token,mode=0400,target=/run/secrets/gh-token

# Environment
Environment=HOME=/home/openclaw
Environment=OPENCLAW_GITHUB_TOKEN_FILE=/run/secrets/gh-token

[Service]
# Let systemd manage restarts if the container exits unexpectedly
Restart=always
RestartSec=5s
TimeoutStartSec=120

[Install]
WantedBy=graphical-session.target
