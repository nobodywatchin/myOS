[Unit]
Description=OpenClaw Watchdog - keeps the session-bound primary agent running while the graphical session is active
After=graphical-session.target openclaw.service
Requires=graphical-session.target
PartOf=graphical-session.target
Wants=openclaw.service
BindsTo=openclaw.service

[Service]
Type=simple
ExecStart=/usr/bin/bash -lc 'while true; do if ! systemctl --user is-active --quiet openclaw.service; then echo "OpenClaw is not active - restarting it now" | systemd-cat -t openclaw-watchdog -p warning; systemctl --user restart openclaw.service; fi; sleep 30; done'
Restart=always
RestartSec=10s

[Install]
WantedBy=graphical-session.target
