# Zone B browser and parser settings. These services stay pod-local unless an
# operator explicitly publishes or proxies them later.
BROWSER_IMAGE=registry.example.invalid/openclaw/browser-zone:stable
BROWSER_LISTEN=0.0.0.0:3000
PARSER_IMAGE=registry.example.invalid/openclaw/parser-zone:stable
PARSER_LISTEN=0.0.0.0:8081
CONTROL_LISTEN=0.0.0.0:8090
