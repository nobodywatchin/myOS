# Tenant-local OpenClaw runtime settings. Browser and parser endpoints resolve
# over the tenant pod's shared localhost namespace.
OPENCLAW_IMAGE=registry.example.invalid/openclaw/runtime:stable
OPENCLAW_LISTEN=0.0.0.0:8080
OPENCLAW_STORAGE_ROOT=/srv/openclaw-storage
OPENCLAW_BROWSER_ENDPOINT=http://127.0.0.1:3000
OPENCLAW_PARSER_ENDPOINT=http://127.0.0.1:8081
