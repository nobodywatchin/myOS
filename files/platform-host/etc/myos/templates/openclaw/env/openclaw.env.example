# OpenClaw runtime defaults. myos tenant-configure updates this file and
# tenant-config-render turns it into the live openclaw.json config.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.3.13-1
OPENCLAW_MODEL_PRIMARY=openrouter/anthropic/claude-sonnet-4-5
OPENCLAW_GATEWAY_MODE=local
OPENCLAW_UI_ALLOW_INSECURE_AUTH=false
OPENCLAW_CONTROL_UI_EXTRA_ORIGINS=
OPENCLAW_MEMORY_MAX=4G
OPENCLAW_CPU_QUOTA=200%
OPENCLAW_TASKS_MAX=512
