[Unit]
Description=OpenClaw Zone A agent services for __TENANT__
After=network-online.target
Wants=network-online.target

[Container]
Pod=openclaw-stack.pod
Image=__AGENT_IMAGE__
ContainerName=zone-a-agent-__TENANT__
AutoUpdate=registry
EnvironmentFile=__TENANT_ROOT__/config/env/common.env
EnvironmentFile=__TENANT_ROOT__/config/env/openclaw.env
Volume=__TENANT_ROOT__/zone-a/agent:/srv/agent:Z,U
Volume=__TENANT_ROOT__/zone-c/storage:/srv/openclaw-storage:Z,U

[Install]
WantedBy=default.target
