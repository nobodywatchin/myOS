[Unit]
Description=OpenClaw Zone B parser services for __TENANT__
After=network-online.target
Wants=network-online.target

[Container]
Pod=openclaw-stack.pod
Image=__PARSER_IMAGE__
ContainerName=zone-b-parser-__TENANT__
AutoUpdate=registry
EnvironmentFile=__TENANT_ROOT__/config/env/ports.env
EnvironmentFile=__TENANT_ROOT__/config/env/browser.env
Volume=__TENANT_ROOT__/zone-b/parser:/srv/parser:Z,U
Volume=__TENANT_ROOT__/zone-b/downloads:/srv/parser-downloads:Z,U
Volume=__TENANT_ROOT__/zone-c/storage:/srv/openclaw-storage:Z,U

[Install]
WantedBy=default.target
