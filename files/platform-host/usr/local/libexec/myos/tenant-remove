#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/libexec/myos/common.sh

usage() {
  cat <<'USAGE'
Usage: tenant-remove --tenant NAME [--disable-linger] [--purge-storage] [--purge-user] --yes

Remove rendered Quadlet files and optional tenant state. Subuid and subgid
entries are left in place for auditability.
USAGE
}

tenant=""
disable_linger=0
purge_storage=0
purge_user=0
confirmed=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --disable-linger)
      disable_linger=1
      shift
      ;;
    --purge-storage)
      purge_storage=1
      shift
      ;;
    --purge-user)
      purge_user=1
      shift
      ;;
    --yes)
      confirmed=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
[ "$confirmed" -eq 1 ] || die "tenant-remove requires --yes"

if getent passwd "$tenant" >/dev/null 2>&1; then
  try_user_systemctl "$tenant" disable --now openclaw.service openclaw-stack-pod.service browser-zone.service zone-a-agent.service zone-b-parser.service || true
fi

if [ "$disable_linger" -eq 1 ]; then
  loginctl disable-linger "$tenant" >/dev/null 2>&1 || true
fi

rm -f "/etc/myos/proxy/tenants/${tenant}.conf" \
  "/etc/myos/proxy/tenants/${tenant}.conf.example" \
  "/etc/myos/firewall/tenants/${tenant}.env" \
  "/etc/myos/firewall/rendered/${tenant}.plan"

if [ -f "$PORT_STATE_FILE" ]; then
  tmp="$(mktemp)"
  awk -v t="$tenant" '$1 != t' "$PORT_STATE_FILE" > "$tmp"
  mv "$tmp" "$PORT_STATE_FILE"
fi

if getent passwd "$tenant" >/dev/null 2>&1; then
  rm -f \
    "$(tenant_home "$tenant")/.config/containers/systemd/openclaw.container" \
    "$(tenant_home "$tenant")/.config/containers/systemd/openclaw-stack.pod" \
    "$(tenant_home "$tenant")/.config/containers/systemd/browser-zone.container" \
    "$(tenant_home "$tenant")/.config/containers/systemd/zone-a-agent.container" \
    "$(tenant_home "$tenant")/.config/containers/systemd/zone-b-parser.container"
fi

if [ "$purge_storage" -eq 1 ]; then
  rm -rf "$(tenant_root "$tenant")" "$(tenant_podman_root "$tenant")"
fi

if [ "$purge_user" -eq 1 ] && getent passwd "$tenant" >/dev/null 2>&1; then
  userdel "$tenant"
fi

log "removed tenant ${tenant} scaffold"
