#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-optimize-tokens --tenant NAME --profile cost|balanced|quality [--restart]

Apply opinionated token-usage defaults using supported OpenClaw config fields.
USAGE
}

tenant=""
profile=""
restart_after=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --profile)
      profile="${2:-}"
      shift 2
      ;;
    --restart)
      restart_after=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi
if [ -z "$profile" ] && [ -t 0 ]; then
  printf 'Token profile [cost/balanced/quality]: '
  read -r profile
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

case "$profile" in
  cost)
    image_max_dimension_px=800
    cache_retention=short
    ;;
  balanced)
    image_max_dimension_px=1200
    cache_retention=short
    ;;
  quality)
    image_max_dimension_px=1600
    cache_retention=long
    ;;
  *)
    die "profile must be one of: cost, balanced, quality"
    ;;
esac

primary_model="$(tenant_primary_model_from_config "$tenant" 2>/dev/null || true)"
if [ -z "$primary_model" ]; then
  primary_model="$(/usr/local/libexec/myos/tenant-config --tenant "$tenant" get agents.defaults.model.primary 2>/dev/null | tail -n 1 || true)"
fi
primary_model="${primary_model:-openrouter/anthropic/claude-sonnet-4-5}"

/usr/local/libexec/myos/tenant-config --tenant "$tenant" set agents.defaults.imageMaxDimensionPx "$image_max_dimension_px" --strict-json
/usr/local/libexec/myos/tenant-config --tenant "$tenant" set agents.defaults.contextPruning.mode '"cache-ttl"' --strict-json
/usr/local/libexec/myos/tenant-config --tenant "$tenant" set "agents.defaults.models[\"${primary_model}\"].params.cacheRetention" "\"${cache_retention}\"" --strict-json

if [ "$restart_after" -eq 1 ]; then
  /usr/local/libexec/myos/tenant-restart --tenant "$tenant"
else
  log "applied ${profile} token profile for ${tenant}; hybrid reload should pick up the config change automatically"
fi
