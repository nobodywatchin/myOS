#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-config --tenant NAME <get|set|unset|file|validate|show|patch|apply> [args...]

Docs-aligned config helpers for a tenant OpenClaw runtime.

Examples:
  tenant-config --tenant oc-demo get agents.defaults.model.primary
  tenant-config --tenant oc-demo set agents.defaults.imageMaxDimensionPx 800 --strict-json
  tenant-config --tenant oc-demo show
  tenant-config --tenant oc-demo patch --raw '{ gateway: { controlUi: { allowInsecureAuth: false } } }'
USAGE
}

tenant=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

subcommand="${1:-}"
[ -n "$subcommand" ] || die "missing config subcommand"
shift || true

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

case "$subcommand" in
  get|set|unset|file|validate)
    run_tenant_openclaw_cli "$tenant" config "$subcommand" "$@"
    ;;
  show)
    cat "$(tenant_config_file "$tenant")"
    ;;
  patch|apply)
    raw=""
    input_file=""
    session_key=""
    note_value=""
    restart_delay_ms=""

    while [ "$#" -gt 0 ]; do
      case "$1" in
        --raw)
          raw="${2:-}"
          shift 2
          ;;
        --file)
          input_file="${2:-}"
          shift 2
          ;;
        --session-key)
          session_key="${2:-}"
          shift 2
          ;;
        --note)
          note_value="${2:-}"
          shift 2
          ;;
        --restart-delay-ms)
          restart_delay_ms="${2:-}"
          shift 2
          ;;
        --)
          shift
          break
          ;;
        *)
          if [ -z "$raw" ] && [ -z "$input_file" ]; then
            raw="$1"
            shift
          else
            die "unknown argument for ${subcommand}: $1"
          fi
          ;;
      esac
    done

    if [ -z "$raw" ] && [ -z "$input_file" ] && [ ! -t 0 ]; then
      raw="$(cat)"
    fi
    if [ -n "$input_file" ]; then
      [ -f "$input_file" ] || die "patch/apply file not found: $input_file"
      raw="$(cat "$input_file")"
    fi
    [ -n "$raw" ] || die "provide --raw JSON5, --file PATH, or stdin content for ${subcommand}"

    get_payload="$(run_tenant_openclaw "$tenant" gateway call config.get --params '{}' --json 2>/dev/null)" || die "failed to fetch the live config hash; make sure openclaw.service is running"
    base_hash="$(printf '%s' "$get_payload" | python3 - <<'PYTHON'
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)

result = data.get('result') if isinstance(data, dict) else None
if isinstance(result, dict):
    value = result.get('hash')
    if isinstance(value, str):
        print(value)
PYTHON
)"

    params_json="$(python3 - "$subcommand" "$raw" "$base_hash" "$session_key" "$note_value" "$restart_delay_ms" <<'PYTHON'
import json
import sys

subcommand = sys.argv[1]
raw = sys.argv[2]
base_hash = sys.argv[3]
session_key = sys.argv[4]
note_value = sys.argv[5]
restart_delay_ms = sys.argv[6]

payload = {'raw': raw}
if base_hash:
    payload['baseHash'] = base_hash
elif subcommand == 'patch':
    raise SystemExit('config.patch requires a baseHash from config.get')
if session_key:
    payload['sessionKey'] = session_key
if note_value:
    payload['note'] = note_value
if restart_delay_ms:
    payload['restartDelayMs'] = int(restart_delay_ms)
print(json.dumps(payload))
PYTHON
)" || die "$params_json"

    run_tenant_openclaw "$tenant" gateway call "config.${subcommand}" --params "$params_json" --json
    ;;
  *)
    die "unsupported config subcommand: ${subcommand}"
    ;;
esac
