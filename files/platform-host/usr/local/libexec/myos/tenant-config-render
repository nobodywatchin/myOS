#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-config-render --tenant NAME

Seed a tenant OpenClaw config if it is missing and ensure the same-port
loopback dashboard origins are present.
USAGE
}

tenant=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

TENANT_ENV_DIR="$(tenant_env_dir "$tenant")"
TENANT_STATE_DIR="$(tenant_state_dir "$tenant")"
TENANT_CONFIG_FILE="$(tenant_config_file "$tenant")"

ensure_dir 0750 "$tenant" "$tenant" "$TENANT_ENV_DIR"
ensure_dir 0750 "$tenant" "$tenant" "$TENANT_STATE_DIR"

write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/common.env.example" "${TENANT_ENV_DIR}/common.env"
write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/openclaw.env.example" "${TENANT_ENV_DIR}/openclaw.env"

if [ ! -f "${TENANT_ENV_DIR}/ports.env" ]; then
  /usr/local/libexec/myos/tenant-port-allocate --tenant "$tenant"
fi

# shellcheck disable=SC1090
. "${TENANT_ENV_DIR}/ports.env"

result="$(python3 - "$TENANT_CONFIG_FILE" "$OPENCLAW_PORT" <<'PYTHON'
import json
import sys
from pathlib import Path

output = Path(sys.argv[1])
port = sys.argv[2]
default_origins = [
    f'http://127.0.0.1:{port}',
    f'http://localhost:{port}',
]
default_config = {
    'gateway': {
        'mode': 'local',
        'reload': {'mode': 'hybrid'},
        'controlUi': {
            'allowedOrigins': default_origins,
            'allowInsecureAuth': False,
        },
    },
    'agents': {
        'defaults': {
            'model': {
                'primary': 'openrouter/anthropic/claude-sonnet-4-5',
            }
        }
    },
}

changed = False
created = False

if not output.exists():
    config = default_config
    changed = True
    created = True
else:
    try:
        with output.open('r', encoding='utf-8') as handle:
            config = json.load(handle)
    except Exception:
        print('preserved-invalid')
        raise SystemExit(0)

    if not isinstance(config, dict):
        config = {}
        changed = True

    gateway = config.get('gateway')
    if not isinstance(gateway, dict):
        gateway = {}
        config['gateway'] = gateway
        changed = True

    if not isinstance(gateway.get('mode'), str) or not gateway.get('mode', '').strip():
        gateway['mode'] = 'local'
        changed = True

    reload_cfg = gateway.get('reload')
    if not isinstance(reload_cfg, dict):
        reload_cfg = {'mode': 'hybrid'}
        gateway['reload'] = reload_cfg
        changed = True
    elif not isinstance(reload_cfg.get('mode'), str) or not reload_cfg.get('mode', '').strip():
        reload_cfg['mode'] = 'hybrid'
        changed = True

    control_ui = gateway.get('controlUi')
    if not isinstance(control_ui, dict):
        control_ui = {}
        gateway['controlUi'] = control_ui
        changed = True

    origins = control_ui.get('allowedOrigins')
    if not isinstance(origins, list):
        origins = []
        changed = True
    for origin in default_origins:
        if origin not in origins:
            origins.append(origin)
            changed = True
    control_ui['allowedOrigins'] = origins

    if 'allowInsecureAuth' not in control_ui:
        control_ui['allowInsecureAuth'] = False
        changed = True

    agents = config.get('agents')
    if not isinstance(agents, dict):
        agents = {}
        config['agents'] = agents
        changed = True

    defaults = agents.get('defaults')
    if not isinstance(defaults, dict):
        defaults = {}
        agents['defaults'] = defaults
        changed = True

    model_cfg = defaults.get('model')
    if not isinstance(model_cfg, dict):
        model_cfg = {}
        defaults['model'] = model_cfg
        changed = True

    if not isinstance(model_cfg.get('primary'), str) or not model_cfg.get('primary', '').strip():
        model_cfg['primary'] = 'openrouter/anthropic/claude-sonnet-4-5'
        changed = True

if changed:
    with output.open('w', encoding='utf-8') as handle:
        json.dump(config, handle, indent=2)
        handle.write('\n')

print('created' if created else 'updated' if changed else 'preserved')
PYTHON
)"

chown "$tenant:$tenant" "$TENANT_CONFIG_FILE"
chmod 0640 "$TENANT_CONFIG_FILE"
restorecon_if_available "$TENANT_CONFIG_FILE"

case "$result" in
  created)
    log "seeded OpenClaw config for ${tenant}"
    ;;
  updated)
    log "updated OpenClaw config defaults for ${tenant}"
    ;;
  preserved)
    log "preserved existing OpenClaw config for ${tenant}"
    ;;
  preserved-invalid)
    warn "preserved existing OpenClaw config for ${tenant}; file is not strict JSON and was left untouched"
    ;;
  *)
    warn "unexpected tenant-config-render result for ${tenant}: ${result}"
    ;;
esac
