#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-tailscale <enable|disable|status|url|reconcile|qr> [options]

Manage host-level Tailscale Serve exposure for a tenant OpenClaw gateway.
USAGE
}

persist_tailscale_metadata() {
  local tenant="$1"
  local exposure="$2"
  local origin="$3"
  local common_env

  common_env="$(tenant_common_env_file "$tenant")"
  set_env_value "$common_env" TAILSCALE_EXPOSURE "$exposure"
  set_env_value "$common_env" TAILSCALE_LAST_ORIGIN "$origin"
  chown "$tenant:$tenant" "$common_env"
  chmod 0640 "$common_env"
  restorecon_if_available "$common_env"
}

ensure_tenant_ready() {
  local tenant="$1"

  validate_tenant "$tenant"
  getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"
}

require_running_service() {
  local tenant="$1"

  try_user_systemctl "$tenant" is-active openclaw.service || die "openclaw.service is not active for ${tenant}"
}

reconcile_one() {
  local tenant="$1"
  local quiet="${2:-0}"
  local dns port target origin old_origin remove_csv=""

  ensure_tenant_ready "$tenant"
  [ "$(tenant_tailscale_exposure "$tenant")" = serve ] || {
    [ "$quiet" -eq 1 ] || note "Tailscale exposure is disabled for ${tenant}"
    return 0
  }

  require_running_service "$tenant"
  dns="$(tailscale_require_ready)"
  port="$(tenant_gateway_port "$tenant")"
  target="http://127.0.0.1:${port}"
  origin="https://${dns}:${port}"
  old_origin="$(tenant_tailscale_last_origin "$tenant")"
  if [ -n "$old_origin" ] && [ "$old_origin" != "$origin" ]; then
    remove_csv="$old_origin"
  fi

  tenant_control_ui_allowed_origins_json "$tenant" >/dev/null
  tailscale serve --bg --https="$port" "$target" >/dev/null
  if ! tenant_sync_control_ui_origins "$tenant" "$origin" "$remove_csv"; then
    tailscale serve --https="$port" off >/dev/null 2>&1 || true
    die "failed to update gateway.controlUi.allowedOrigins for ${tenant}"
  fi

  persist_tailscale_metadata "$tenant" serve "$origin"

  if [ "$quiet" -eq 0 ]; then
    log "enabled host-managed Tailscale Serve for ${tenant}"
    printf 'Dashboard: %s
' "$(tenant_tailscale_http_url "$tenant")"
    printf 'Gateway: %s
' "$(tenant_tailscale_ws_url "$tenant")"
  fi
}

status_one() {
  local tenant="$1"
  local exposure dns http_url ws_url port target mapping

  ensure_tenant_ready "$tenant"
  exposure="$(tenant_tailscale_exposure "$tenant")"
  port="$(tenant_gateway_port "$tenant" || true)"
  target="$(tenant_tailscale_target "$tenant" 2>/dev/null || true)"
  dns="$(tailscale_self_dns_name 2>/dev/null || true)"
  http_url="$(tenant_tailscale_http_url "$tenant" 2>/dev/null || printf 'unavailable')"
  ws_url="$(tenant_tailscale_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
  mapping="unavailable"
  if [ -n "$port" ] && [ -n "$target" ] && tailscale_serve_has_mapping "$port" "$target" 2>/dev/null; then
    mapping="configured"
  elif [ "$exposure" = serve ]; then
    mapping="missing"
  fi

  printf 'Tenant: %s
' "$tenant"
  printf 'Exposure: %s
' "$exposure"
  printf 'tailscale installed: %s
' "$(tailscale_installed && printf yes || printf no)"
  printf 'tailscaled active: %s
' "$(tailscale_service_active && printf yes || printf no)"
  printf 'MagicDNS name: %s
' "${dns:-unavailable}"
  printf 'Stored origin: %s
' "$(tenant_tailscale_last_origin "$tenant" || printf '')"
  if [ "$exposure" = serve ]; then
    printf 'Dashboard: %s
' "$http_url"
    printf 'Gateway: %s
' "$ws_url"
    printf 'Serve mapping: %s
' "$mapping"
  fi
}

url_one() {
  local tenant="$1"
  local mode="$2"

  ensure_tenant_ready "$tenant"
  [ "$(tenant_tailscale_exposure "$tenant")" = serve ] || die "Tailscale exposure is not enabled for ${tenant}"
  tailscale_require_ready >/dev/null

  case "$mode" in
    ws)
      tenant_tailscale_ws_url "$tenant"
      ;;
    http)
      tenant_tailscale_http_url "$tenant"
      ;;
    *)
      die "unknown URL mode: ${mode}"
      ;;
  esac
}

enable_one() {
  local tenant="$1"

  ensure_tenant_ready "$tenant"
  require_running_service "$tenant"
  tailscale_require_ready >/dev/null
  persist_tailscale_metadata "$tenant" serve "$(tenant_tailscale_last_origin "$tenant" || true)"
  if ! reconcile_one "$tenant" 0; then
    persist_tailscale_metadata "$tenant" off ""
    return 1
  fi
}

disable_one() {
  local tenant="$1"
  local port old_origin current_origin="" remove_csv=""

  ensure_tenant_ready "$tenant"
  [ "$(tenant_tailscale_exposure "$tenant")" = serve ] || {
    log "Tailscale exposure is already disabled for ${tenant}"
    return 0
  }

  port="$(tenant_gateway_port "$tenant")"
  old_origin="$(tenant_tailscale_last_origin "$tenant")"
  current_origin="$(tenant_tailscale_origin "$tenant" 2>/dev/null || true)"

  if [ -n "$old_origin" ]; then
    remove_csv="$old_origin"
  fi
  if [ -n "$current_origin" ] && [ "$current_origin" != "$old_origin" ]; then
    remove_csv="${remove_csv:+${remove_csv},}${current_origin}"
  fi

  tenant_sync_control_ui_origins "$tenant" "" "$remove_csv" >/dev/null || die "failed to remove the managed Tailscale origin for ${tenant}"
  tailscale_installed || die "tailscale CLI is not installed on the host"
  tailscale_service_active || die "tailscaled.service is not active on the host"
  tailscale serve --https="$port" off >/dev/null
  persist_tailscale_metadata "$tenant" off ""
  log "disabled host-managed Tailscale Serve for ${tenant}"
}

qr_one() {
  local tenant="$1"
  local http_url ws_url token

  ensure_tenant_ready "$tenant"
  [ "$(tenant_tailscale_exposure "$tenant")" = serve ] || die "enable Tailscale exposure for ${tenant} before generating a pairing QR"
  require_running_service "$tenant"
  reconcile_one "$tenant" 1

  http_url="$(tenant_tailscale_http_url "$tenant")"
  ws_url="$(tenant_tailscale_ws_url "$tenant")"
  token="$(env_value_from_file "$(tenant_secret_file "$tenant")" OPENCLAW_GATEWAY_TOKEN 2>/dev/null || true)"
  [ -n "$token" ] || die "gateway token is not configured for ${tenant}"

  run_tenant_openclaw_cli "$tenant" qr --url "$ws_url" --public-url "$http_url" --token "$token"
}

reconcile_all() {
  local failed=0 tenant

  while IFS= read -r tenant; do
    [ -n "$tenant" ] || continue
    if [ "$(tenant_tailscale_exposure "$tenant" 2>/dev/null || printf 'off')" != serve ]; then
      continue
    fi
    if ! reconcile_one "$tenant" 0; then
      failed=1
    fi
  done < <(find "$TENANT_BASE" -mindepth 1 -maxdepth 1 -type d -printf '%f
' | LC_ALL=C sort)

  return "$failed"
}

note() {
  printf '[myos] %s
' "$*"
}

subcommand="${1:-}"
[ -n "$subcommand" ] || {
  usage
  exit 1
}
shift || true

tenant=""
url_mode="http"
reconcile_all_flag=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --ws)
      url_mode="ws"
      shift
      ;;
    --http)
      url_mode="http"
      shift
      ;;
    --all)
      reconcile_all_flag=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ "$reconcile_all_flag" -eq 0 ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root

case "$subcommand" in
  enable)
    enable_one "$tenant"
    ;;
  disable)
    disable_one "$tenant"
    ;;
  status)
    status_one "$tenant"
    ;;
  url)
    url_one "$tenant" "$url_mode"
    ;;
  qr)
    qr_one "$tenant"
    ;;
  reconcile)
    if [ "$reconcile_all_flag" -eq 1 ]; then
      reconcile_all
    else
      reconcile_one "$tenant" 0
    fi
    ;;
  *)
    die "unsupported tenant-tailscale subcommand: ${subcommand}"
    ;;
esac
