#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/libexec/myos/common.sh

usage() {
  cat <<'USAGE'
Usage: tenant-secrets-init --tenant NAME

Create placeholder secret files and private env stubs for a tenant.
USAGE
}

tenant=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

TENANT="$tenant"
TENANT_ROOT="$(tenant_root "$tenant")"
TENANT_HOME="$(tenant_home "$tenant")"
TENANT_ENV_DIR="$(tenant_env_dir "$tenant")"
TENANT_SECRET_DIR="$(tenant_secret_dir "$tenant")"
TENANT_STATE_DIR="$(tenant_state_dir "$tenant")"

if [ ! -f "${TENANT_ENV_DIR}/ports.env" ]; then
  /usr/local/libexec/myos/tenant-port-allocate --tenant "$tenant"
fi

# shellcheck disable=SC1090
. "${TENANT_ENV_DIR}/ports.env"

ensure_dir 0750 "$tenant" "$tenant" "$TENANT_ENV_DIR"
ensure_dir 0700 "$tenant" "$tenant" "$TENANT_SECRET_DIR"
ensure_dir 0750 "$tenant" "$tenant" "$TENANT_STATE_DIR"

write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/common.env.example" "${TENANT_ENV_DIR}/common.env"
write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/ports.env.example" "${TENANT_ENV_DIR}/ports.example"
write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/openclaw.env.example" "${TENANT_ENV_DIR}/openclaw.env"
write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/env/mounts.env.example" "${TENANT_ENV_DIR}/mounts.env"
write_if_missing 0640 "$tenant" "$tenant" "/etc/myos/firewall/tenant-egress.env.example" "${TENANT_ENV_DIR}/firewall.env"
write_if_missing 0640 "$tenant" "$tenant" "/etc/myos/dns/tenant-dns.env.example" "${TENANT_ENV_DIR}/dns.env"
write_if_missing 0640 "$tenant" "$tenant" "${TEMPLATE_BASE}/config/openclaw.json.example" "${TENANT_STATE_DIR}/openclaw.json"

if [ ! -e "${TENANT_SECRET_DIR}/openclaw.secrets.env" ]; then
  OPENCLAW_GATEWAY_TOKEN="$(generate_secret_value)"
  render_template_file "${TEMPLATE_BASE}/env/openclaw.secrets.env.example" "${TENANT_SECRET_DIR}/openclaw.secrets.env"
  chown "$tenant:$tenant" "${TENANT_SECRET_DIR}/openclaw.secrets.env"
  chmod 0600 "${TENANT_SECRET_DIR}/openclaw.secrets.env"
fi

if ! grep -q '^OPENCLAW_GATEWAY_TOKEN=' "${TENANT_SECRET_DIR}/openclaw.secrets.env"; then
  printf '\nOPENCLAW_GATEWAY_TOKEN=%s\n' "$(generate_secret_value)" >> "${TENANT_SECRET_DIR}/openclaw.secrets.env"
fi

restorecon_if_available "$TENANT_ENV_DIR" "$TENANT_SECRET_DIR" "$TENANT_STATE_DIR"

log "secret and env placeholders created for tenant ${tenant}"
