#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/libexec/myos/common.sh

usage() {
  cat <<'USAGE'
Usage: tenant-port-allocate --tenant NAME

Reserve localhost ports for a tenant and write config/env/ports.env.
USAGE
}

tenant=""
start_port="${MYOS_TENANT_PORT_START:-41000}"
end_port="${MYOS_TENANT_PORT_END:-48999}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

ensure_dir 0750 "$tenant" "$tenant" "$(tenant_env_dir "$tenant")"
ensure_dir 0755 root root "$(dirname "$PORT_STATE_FILE")"
touch "$PORT_STATE_FILE"

while ! mkdir "$PORT_LOCK_DIR" 2>/dev/null; do
  sleep 1
done
trap 'rmdir "$PORT_LOCK_DIR" 2>/dev/null || true' EXIT

state_lookup() {
  awk -v t="$tenant" -v k="$1" '$1 == t && $2 == k { print $3; exit }' "$PORT_STATE_FILE"
}

port_busy() {
  local port="$1"

  grep -Eq "^[^#[:space:]]+[[:space:]]+[^#[:space:]]+[[:space:]]+${port}$" "$PORT_STATE_FILE" && return 0
  ss -Hltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|[:\\]])${port}$"
}

reserve_port() {
  local key="$1"
  local port
  local tmp

  port="$(state_lookup "$key" || true)"
  if [ -n "$port" ]; then
    printf '%s\n' "$port"
    return 0
  fi

  for port in $(seq "$start_port" "$end_port"); do
    if ! port_busy "$port"; then
      tmp="$(mktemp)"
      awk -v t="$tenant" -v k="$key" '!( $1 == t && $2 == k )' "$PORT_STATE_FILE" > "$tmp"
      printf '%s %s %s\n' "$tenant" "$key" "$port" >> "$tmp"
      mv "$tmp" "$PORT_STATE_FILE"
      printf '%s\n' "$port"
      return 0
    fi
  done

  die "no free ports remain in ${start_port}-${end_port}"
}

OPENCLAW_PORT="$(reserve_port OPENCLAW_PORT)"
BROWSER_PORT="$(reserve_port BROWSER_PORT)"
PARSER_PORT="$(reserve_port PARSER_PORT)"
CONTROL_PORT="$(reserve_port CONTROL_PORT)"

cat > "$(tenant_env_dir "$tenant")/ports.env" <<EOF_PORTS
# Generated by tenant-port-allocate for ${tenant}
OPENCLAW_PORT=${OPENCLAW_PORT}
BROWSER_PORT=${BROWSER_PORT}
PARSER_PORT=${PARSER_PORT}
CONTROL_PORT=${CONTROL_PORT}
EOF_PORTS

chown "$tenant:$tenant" "$(tenant_env_dir "$tenant")/ports.env"
chmod 0640 "$(tenant_env_dir "$tenant")/ports.env"
restorecon_if_available "$(tenant_env_dir "$tenant")/ports.env"

log "allocated localhost ports for ${tenant}: openclaw=${OPENCLAW_PORT}, browser=${BROWSER_PORT}, parser=${PARSER_PORT}, control=${CONTROL_PORT}"
