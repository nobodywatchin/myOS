#!/usr/bin/env bash
set -Eeuo pipefail

COMMON_SH="${MYOS_COMMON_SH:-/usr/local/libexec/myos/common.sh}"
. "$COMMON_SH"

usage() {
  cat <<'USAGE'
Usage: tenant-status --tenant NAME [--show-token]

Show the current tenant status, endpoints, and recent logs.
USAGE
}

tenant=""
show_token=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --tenant)
      tenant="${2:-}"
      shift 2
      ;;
    --show-token)
      show_token=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$tenant" ] && [ -t 0 ]; then
  printf 'Tenant name: '
  read -r tenant
fi

require_root
validate_tenant "$tenant"
getent passwd "$tenant" >/dev/null 2>&1 || die "tenant user ${tenant} does not exist yet"

ports_env="$(tenant_env_dir "$tenant")/ports.env"
common_env="$(tenant_env_dir "$tenant")/common.env"
openclaw_env="$(tenant_env_dir "$tenant")/openclaw.env"
secret_file="$(tenant_secret_file "$tenant")"
container_name="$(tenant_container_name "$tenant")"

service_state="inactive"
if try_user_systemctl "$tenant" is-active openclaw.service; then
  service_state=active
fi

container_health="unavailable"
if run_tenant_podman "$tenant" inspect "$container_name" >/dev/null 2>&1; then
  container_health="$(run_tenant_podman "$tenant" inspect -f '{{if .State.Healthcheck}}{{.State.Healthcheck.Status}}{{else}}unknown{{end}}' "$container_name" 2>/dev/null || true)"
fi

printf 'Tenant: %s\n' "$tenant"
printf 'Service: %s\n' "$service_state"
printf 'Container health: %s\n' "$container_health"
printf 'Image: %s\n' "$(env_value_from_file "$openclaw_env" OPENCLAW_IMAGE 2>/dev/null || printf 'unset')"
printf 'Model: %s\n' "$(env_value_from_file "$openclaw_env" OPENCLAW_MODEL_PRIMARY 2>/dev/null || printf 'unset')"
public_hostname="$(env_value_from_file "$common_env" PUBLIC_HOSTNAME 2>/dev/null || true)"
public_hostname="${public_hostname:-${tenant}.example.invalid}"
printf 'Public hostname: %s\n' "$public_hostname"
printf 'UI: %s\n' "$(tenant_ui_url "$tenant" 2>/dev/null || printf 'unavailable')"
printf 'Gateway: %s\n' "$(tenant_gateway_ws_url "$tenant" 2>/dev/null || printf 'unavailable')"
printf 'OpenClaw port: %s\n' "$(env_value_from_file "$ports_env" OPENCLAW_PORT 2>/dev/null || printf 'unset')"
printf 'Bridge port: %s\n' "$(env_value_from_file "$ports_env" OPENCLAW_BRIDGE_PORT 2>/dev/null || printf 'unset')"
printf 'UI port: %s\n' "$(env_value_from_file "$ports_env" OPENCLAW_UI_PORT 2>/dev/null || printf 'unset')"
printf 'Gateway token: %s\n' "$(if [ -n "$(env_value_from_file "$secret_file" OPENCLAW_GATEWAY_TOKEN 2>/dev/null || true)" ]; then printf 'configured'; else printf 'missing'; fi)"
if [ "$show_token" -eq 1 ]; then
  printf 'Gateway token value: %s\n' "$(env_value_from_file "$secret_file" OPENCLAW_GATEWAY_TOKEN 2>/dev/null || printf 'missing')"
fi

printf '\nRecent logs:\n'
run_tenant_podman "$tenant" logs --tail 10 "$container_name" 2>/dev/null || printf 'No container logs available.\n'
