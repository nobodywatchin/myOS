[Unit]
Description=Apply myOS workstation display-manager ownership
Documentation=file:/usr/share/myos/workstation/desktop.env
ConditionPathExists=/usr/share/myos/workstation/desktop.env
After=local-fs.target
Before=display-manager.service graphical.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/myos-workstation-dm-apply

[Install]
WantedBy=multi-user.target
