[Unit]
Description=Stage & load NVIDIA early (immutable)
DefaultDependencies=no
After=local-fs.target sysinit.target
Before=display-manager.service gdm.service sddm.service plymouth-quit.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nvidia-akmods-build.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
