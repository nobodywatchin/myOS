[Unit]
Description=Build & Load NVIDIA akmods on first boot for the running kernel
After=multi-user.target

[Service]
Type=oneshot
# Send output to the journal and also to a file for convenience
ExecStart=/bin/bash -lc '/usr/local/sbin/nvidia-akmods-build.sh | tee -a /var/log/nvidia-akmods-firstboot.log'

[Install]
WantedBy=multi-user.target
